---
import type { Project } from '@utils/posts';
import { getLanguageAccent } from '@utils/posts';
import GithubIcon from '@components/icons/GithubIcon.astro';
import { getLangFromUrl } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  project: Project;
  lang?: Lang;
  index?: number;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const { project, index } = Astro.props;
const data = project.data;

const langLabel = lang === 'zh'
  ? { visit: '访问', source: '源码', fork: 'Fork', open: '在 GitHub 上打开' }
  : { visit: 'Visit', source: 'Source', fork: 'Fork', open: 'Open on GitHub' };

const updated = data.updatedAt ? new Date(data.updatedAt) : null;
const updatedLabel = updated
  ? new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', { dateStyle: 'medium' }).format(updated)
  : '';

const accent = getLanguageAccent(data.languageColor);
const primaryHref = data.repo || data.url || '#';
const hasSeparateVisit = !!data.url && data.url !== data.repo;
---

<article data-stagger-item class="h-full">
  <div class="card card-hover group relative flex h-full flex-col overflow-hidden rounded-[4px]">
    <a
      href={primaryHref}
      target="_blank"
      rel="noopener noreferrer"
      class="absolute inset-0 z-10"
      aria-label={`${langLabel.open} ${data.title}`}
      data-cursor-label={langLabel.open}
    ></a>

    {/* Language accent edge */}
    <span class="h-[3px] w-full shrink-0" style={{ backgroundColor: accent }} aria-hidden="true"></span>

    {/* HUD corner marks on the card frame */}
    <span class="absolute left-2 top-2 z-20 h-3 w-3 border-l-[1.5px] border-t-[1.5px] opacity-0 transition-opacity duration-300 group-hover:opacity-80 pointer-events-none" style={{ borderColor: accent }} aria-hidden="true"></span>
    <span class="absolute bottom-2 right-2 z-20 h-3 w-3 border-b-[1.5px] border-r-[1.5px] opacity-0 transition-opacity duration-300 group-hover:opacity-80 pointer-events-none" style={{ borderColor: accent }} aria-hidden="true"></span>

    {/* Preview: coordinate grid + targeting reticle + watermark index */}
    <div class="relative aspect-phi overflow-hidden bg-[var(--bg-elev)] flex items-center justify-center pointer-events-none">
      <div class="absolute inset-0 schematic-grid"></div>
      <div class="absolute inset-0 halftone opacity-40"></div>

      {index != null && (
        <span class="absolute right-3 bottom-1 font-mono font-extrabold leading-none text-[var(--fg)] opacity-[0.06]" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
      )}

      {index != null && (
        <span class="absolute left-3 top-3 px-1.5 py-0.5 text-[9px] font-mono font-bold uppercase tracking-wider text-[var(--on-accent)] corner-cut" style="background: var(--accent); --corner-cut: 5px" aria-hidden="true">
          REC {String(index + 1).padStart(2, '0')}
        </span>
      )}

      {/* Reticle */}
      <span class="absolute left-3 top-3 h-10 w-10 rounded-full border border-[var(--fg)] opacity-20" aria-hidden="true">
        <span class="absolute left-1/2 top-1/2 h-[2px] w-14 -translate-x-1/2 -translate-y-1/2 bg-[var(--fg)] opacity-60"></span>
        <span class="absolute left-1/2 top-1/2 h-14 w-[2px] -translate-x-1/2 -translate-y-1/2 bg-[var(--fg)] opacity-60"></span>
      </span>

      <div class="relative flex flex-col items-center justify-center w-full h-full p-phi-1 text-center">
        <GithubIcon class="w-9 h-9 text-[var(--fg-muted)] mb-2 transition-transform duration-500 group-hover:scale-110" />
        <h3
          class="text-base sm:text-lg font-mono font-bold tracking-tight truncate max-w-full px-2 group-hover:text-[var(--accent)] transition-colors duration-300"
          transition:name={`qc-proj-${data.id}`}
          data-vt
        >{data.title}</h3>
        {data.fork && (
          <span class="absolute top-3 right-3 px-2 py-0.5 rounded-[2px] text-[10px] font-mono font-bold border border-default text-muted pointer-events-none">
            {langLabel.fork}
          </span>
        )}
      </div>
    </div>

    <div class="p-phi-1 flex flex-col flex-1 pointer-events-none">
      <p class="text-sm text-muted leading-relaxed mb-4 line-clamp-3 flex-1">{data.description}</p>

      <div class="flex items-center flex-wrap gap-x-4 gap-y-1.5 text-xs text-muted font-mono mb-4">
        {data.language && (
          <span class="inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full" style={{ backgroundColor: accent }}></span>
            <span>{data.language}</span>
          </span>
        )}
        <span class="inline-flex items-center gap-1" transition:name={`qc-proj-stars-${data.id}`}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          {data.stars}
        </span>
        <span class="inline-flex items-center gap-1">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M6 8v8M8 7l8-1M8 17l8 1"/></svg>
          {data.forks}
        </span>
        {updatedLabel && (
          <span class="text-[11px]">· {updatedLabel}</span>
        )}
      </div>

      <div class="flex items-center gap-3 mt-auto">
        {hasSeparateVisit && data.url && (
          <a
            href={data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-20 inline-flex items-center gap-1.5 text-xs text-muted hover:text-[var(--accent)] transition-colors duration-300 pointer-events-auto font-mono"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            {langLabel.visit}
          </a>
        )}
        <span class="relative z-20 inline-flex items-center gap-1.5 text-xs text-muted pointer-events-none font-mono">
          <GithubIcon class="w-3.5 h-3.5" />
          {langLabel.source}
        </span>
      </div>
    </div>
  </div>
</article>
