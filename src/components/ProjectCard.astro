---
import type { Project } from '@utils/posts';
import { getLangFromUrl } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  project: Project;
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const { project } = Astro.props;

const data = project.data;

const langLabel = lang === 'zh'
  ? { visit: '访问', source: '源码', fork: 'Fork' }
  : { visit: 'Visit', source: 'Source', fork: 'Fork' };

const updated = data.updatedAt ? new Date(data.updatedAt) : null;
const updatedLabel = updated
  ? new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', { dateStyle: 'medium' }).format(updated)
  : '';

const langDotClass = {
  blue: 'bg-blue-500',
  yellow: 'bg-yellow-500',
  emerald: 'bg-emerald-500',
  cyan: 'bg-cyan-500',
  orange: 'bg-orange-500',
  red: 'bg-red-500',
  pink: 'bg-pink-500',
  green: 'bg-green-500',
  zinc: 'bg-zinc-400',
}[data.languageColor ?? 'zinc'] ?? 'bg-zinc-400';

const primaryHref = data.repo || data.url || '#';
const hasSeparateVisit = !!data.url && data.url !== data.repo;
---

<article data-stagger-item>
  <div class="card card-hover overflow-hidden h-full flex flex-col group relative">
    <a
      href={primaryHref}
      target="_blank"
      rel="noopener noreferrer"
      class="absolute inset-0 z-10"
      aria-label={`Open ${data.title} on GitHub`}
    ></a>

    <div class="relative overflow-hidden aspect-phi bg-[var(--bg-elev)] flex items-center justify-center pointer-events-none">
      <div class="absolute inset-0 opacity-[0.04] dark:opacity-[0.06]"
        style="background-image: linear-gradient(var(--fg) 1px, transparent 1px), linear-gradient(90deg, var(--fg) 1px, transparent 1px); background-size: 32px 32px;"></div>
      <div class="relative flex flex-col items-center justify-center w-full h-full p-phi-1 text-center">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--fg-muted)] mb-2 transition-transform duration-500 group-hover:scale-110">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        <h3 class="text-base sm:text-lg font-mono font-bold tracking-tight truncate max-w-full px-2">{data.title}</h3>
        {data.fork && (
          <span class="absolute top-3 right-3 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold border border-default text-muted pointer-events-none">
            {langLabel.fork}
          </span>
        )}
      </div>
    </div>

    <div class="p-phi-1 flex flex-col flex-1 pointer-events-none">
      <p class="text-sm text-muted leading-relaxed mb-4 line-clamp-3 flex-1">{data.description}</p>

      <div class="flex items-center flex-wrap gap-x-4 gap-y-1.5 text-xs text-muted mb-4">
        {data.language && (
          <span class="inline-flex items-center gap-1.5">
            <span class:list={['w-2 h-2 rounded-full', langDotClass]}></span>
            <span class="font-mono">{data.language}</span>
          </span>
        )}
        <span class="inline-flex items-center gap-1">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          {data.stars}
        </span>
        <span class="inline-flex items-center gap-1">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M6 8v8M8 7l8-1M8 17l8 1"/></svg>
          {data.forks}
        </span>
        {updatedLabel && (
          <span class="font-mono text-[11px]">· {updatedLabel}</span>
        )}
      </div>

      <div class="flex items-center gap-3 mt-auto">
        {hasSeparateVisit && data.url && (
          <a
            href={data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-20 inline-flex items-center gap-1.5 text-xs font-medium text-muted hover:text-[var(--accent)] transition-colors duration-300 pointer-events-auto"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            {langLabel.visit}
          </a>
        )}
        <span class="relative z-20 inline-flex items-center gap-1.5 text-xs font-medium text-muted pointer-events-none">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          {langLabel.source}
        </span>
      </div>
    </div>
  </div>
</article>