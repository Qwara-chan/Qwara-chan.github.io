<div data-cursor-layer aria-hidden="true" hidden>
  <div data-cursor-ring></div>
  <div data-cursor-dot></div>
  <div data-cursor-label></div>
</div>

<script>
  // CursorLayer — the HUD targeting reticle.
  //
  // A fine-pointer-only custom cursor: a ring that lerps to the pointer (via the
  // MotionBus, no own pointermove/rAF), expands + labels interactive targets,
  // and hides under reduced motion / coarse pointers. `cursor: none` is applied
  // to <html> only while active; :focus-visible outlines are untouched.
  //
  // The layer is static HTML with `hidden` by default (no-JS safe) and re-uses
  // the existing node across after-swap re-inits (query, don't re-create).

  let cursorAbort: AbortController | null = null;

  function initCursor() {
    cursorAbort?.abort();
    cursorAbort = new AbortController();
    const { signal } = cursorAbort;

    const layer = document.querySelector<HTMLElement>('[data-cursor-layer]');
    if (!layer) return;
    const ring = layer.querySelector<HTMLElement>('[data-cursor-ring]');
    const dot = layer.querySelector<HTMLElement>('[data-cursor-dot]');
    const label = layer.querySelector<HTMLElement>('[data-cursor-label]');

    const fine = window.matchMedia('(pointer: fine)').matches;
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const deactivate = () => {
      document.documentElement.classList.remove('cursor-hidden');
      (window as unknown as { __motionBus?: { remove(id: string): void } }).__motionBus?.remove('cursor');
    };

    if (!fine || rm) {
      deactivate();
      return;
    }

    // Activate: show the layer and hide the native cursor.
    layer.removeAttribute('hidden');
    document.documentElement.classList.add('cursor-hidden');

    const INTERACTIVE =
      'a, button, [role="button"], [data-tilt], [data-cursor], input, textarea, select, [contenteditable]';

    let targetScale = 1;
    let scale = 1;
    let labelText = '';
    let inWindow = false;

    const setInteractive = (el: Element | null) => {
      const t = el?.closest?.(INTERACTIVE) as HTMLElement | null;
      targetScale = t ? (t.dataset.cursorScale ? parseFloat(t.dataset.cursorScale) : 1.6) : 1;
      labelText =
        t?.dataset.cursorLabel ??
        t?.getAttribute('aria-label') ??
        (t && t.textContent ? t.textContent.trim().slice(0, 14) : '');
      if (label) label.textContent = labelText;
    };

    document.addEventListener(
      'pointerover',
      (e) => setInteractive(e.target as Element),
      { passive: true, signal },
    );
    document.addEventListener(
      'pointerout',
      (e) => {
        const to = (e as PointerEvent).relatedTarget as Element | null;
        if (!to || !to.closest?.(INTERACTIVE)) setInteractive(null);
      },
      { passive: true, signal },
    );
    document.addEventListener('pointerenter', () => { inWindow = true; }, { passive: true, signal });
    document.addEventListener('pointerleave', () => { inWindow = false; }, { passive: true, signal });

    // View-transition blind window: the transition top layer covers the reticle,
    // so restore the native cursor for the duration, then re-hide after.
    const hideNative = () => document.documentElement.classList.remove('cursor-hidden');
    const restoreNative = () => { if (fine && !rm) document.documentElement.classList.add('cursor-hidden'); };
    document.addEventListener('astro:before-swap', hideNative, { signal });
    document.addEventListener('astro:after-swap', restoreNative, { signal });
    // Theme toggle's own startViewTransition (dispatched from Navbar.astro).
    document.addEventListener('qw:vt-start', hideNative, { signal });
    document.addEventListener('qw:vt-end', restoreNative, { signal });

    const register = () => {
      (window as unknown as { __motionBus?: { add(id: string, f: (s: never) => void): void } }).__motionBus?.add(
        'cursor',
        (s: never) => {
          const st = s as unknown as { cursor: { x: number; y: number } };
          scale += (targetScale - scale) * 0.16;
          layer.style.transform = `translate3d(${st.cursor.x.toFixed(1)}px, ${st.cursor.y.toFixed(1)}px, 0)`;
          if (ring) {
            ring.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(3)})`;
            ring.classList.toggle('is-interactive', targetScale > 1.05);
          }
          if (dot) dot.style.opacity = inWindow ? '1' : '0';
          if (label) label.classList.toggle('is-visible', targetScale > 1.05 && !!labelText);
        },
      );
    };
    if ((window as unknown as { __motionBus?: unknown }).__motionBus) register();
    else requestAnimationFrame(() => { if (signal.aborted) return; if ((window as unknown as { __motionBus?: unknown }).__motionBus) register(); });

    signal.addEventListener('abort', deactivate);
  }

  initCursor();
  document.addEventListener('astro:after-swap', initCursor);
</script>
