---
interface Props {
  as?: string;
  delay?: number;
  y?: number;
  x?: number;
  scale?: number;
  duration?: number;
  class?: string;
  once?: boolean;
  id?: string;
}

const {
  as: Tag = 'div',
  delay = 0,
  y = 24,
  x = 0,
  scale = 1,
  duration = 0.7,
  class: className = '',
  once = true,
  id,
} = Astro.props;
---

<Tag
  id={id}
  class={className}
  data-animate
  data-scroll-reveal
  data-delay={delay}
  data-y={y}
  data-x={x}
  data-scale={scale}
  data-duration={duration}
  data-once={once}
>
  <slot />
</Tag>

<script>
  // Reveal-on-scroll via IntersectionObserver + CSS transitions. The hidden
  // pre-state (opacity/transform) lives in global.css so there is no flash of
  // visible content before JS runs; reduced-motion and noscript both override it.
  function initScrollReveal() {
    const elements = document.querySelectorAll('[data-scroll-reveal]');

    elements.forEach((el) => {
      if ((el as HTMLElement).dataset.initialized) return;
      (el as HTMLElement).dataset.initialized = 'true';

      const data = (el as HTMLElement).dataset;
      const delay = parseFloat(data.delay || '0');
      const y = parseFloat(data.y || '24');
      const x = parseFloat(data.x || '0');
      const scale = parseFloat(data.scale || '1');
      const duration = parseFloat(data.duration || '0.7');
      const once = data.once !== 'false';

      const style = (el as HTMLElement).style;
      style.setProperty('--reveal-x', `${x}px`);
      style.setProperty('--reveal-y', `${y}px`);
      style.setProperty('--reveal-scale', String(scale));
      style.setProperty('--reveal-delay', `${delay}s`);
      style.setProperty('--reveal-duration', `${duration}s`);

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              el.classList.add('is-revealed');
              if (once) io.unobserve(el);
            } else if (!once) {
              el.classList.remove('is-revealed');
            }
          });
        },
        { rootMargin: '0px 0px -15% 0px' },
      );
      io.observe(el);
    });
  }

  initScrollReveal();
  document.addEventListener('astro:after-swap', initScrollReveal);
</script>
