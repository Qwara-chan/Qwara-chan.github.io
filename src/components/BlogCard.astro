---
import type { Post } from '@utils/posts';
import { getLangFromUrl, useTranslations, formatDate, getReadingTime, getWordCount, getLocalizedPath } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  post: Post;
  lang?: Lang;
  featured?: boolean;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { post, featured = false } = Astro.props;

const href = getLocalizedPath(`blog/${post.id}`, lang);

const bodyText = post.body ?? '';
const readingTime = getReadingTime(bodyText, lang);
const wordCount = getWordCount(bodyText, lang);

// Stable hue from the title so each post gets a consistent gradient cover.
const titleHash = (str: string) => {
  let h = 0;
  for (let i = 0; i < str.length; i++) {
    h = (h << 5) - h + str.charCodeAt(i);
    h |= 0;
  }
  return Math.abs(h);
};
const coverHue = titleHash(post.data.title) % 360;
---

<article data-stagger-item>
  <a href={href} class:list={['card card-hover block h-full overflow-hidden group', featured ? 'sm:flex sm:items-center' : '']}>
    <div class:list={['relative overflow-hidden bg-[var(--bg-elev)]', featured ? 'sm:w-1/2 aspect-video sm:aspect-auto' : 'aspect-phi']}>
      {post.data.cover ? (
        <img src={post.data.cover} alt={post.data.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
      ) : (
        <div class="w-full h-full flex items-center justify-center relative overflow-hidden"
          style={`background: linear-gradient(135deg, hsl(${coverHue} 65% 58%), hsl(${(coverHue + 45) % 360} 68% 42%));`}>
          <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.4) 0%, transparent 55%);"></div>
          <span class="relative text-5xl font-mono font-black text-white/30 select-none">{post.data.title.charAt(0)}</span>
        </div>
      )}
    </div>

    <div class:list={['p-phi-1', featured ? 'sm:w-1/2' : '']}>
      <div class="flex items-center gap-3 text-xs text-muted mb-3">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
        <span class="w-1 h-1 rounded-full bg-current opacity-30"></span>
        <span>{readingTime} {t('blog.minRead')}</span>
        <span class="w-1 h-1 rounded-full bg-current opacity-30"></span>
        <span>{wordCount.toLocaleString()} {t('common.words')}</span>
      </div>

      <h3 class:list={['font-bold tracking-tight mb-2 transition-colors duration-300', featured ? 'text-2xl' : 'text-lg', 'group-hover:text-[var(--fg)]']}>
        {post.data.title}
      </h3>

      <p class="text-sm text-muted leading-relaxed mb-4 line-clamp-2">{post.data.description}</p>

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {post.data.tags.slice(0, 3).map((tag) => (
            <span class="tag-chip">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>
