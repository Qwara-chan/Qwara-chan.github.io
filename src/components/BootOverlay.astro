---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!--
  Boot overlay — the cinematic tape-loading sequence (~4s, skippable).
  PHASE 01 POWER（CRT 通电：内容面从高亮横线展开）→ PHASE 02 SELF-TEST（打字机诊断）
  → PHASE 03 TAPE LOAD（进度 + 百分比 + 25fps 帧时码）→ PHASE 04 SIGNAL LOCK
  （锁定柱依次点亮）→ 胶片出带口上卷退场，交棒 Hero 解码（qw:boot-done）。

  Static + `hidden` by default so no-JS and JS-failure paths never show it;
  `position: fixed` means zero CLS. The pre-paint gate in BaseLayout adds
  `hero-booting` to <html> on first load, which freezes the .hero-fade
  entrance until this overlay finishes.
-->
<div data-boot-overlay hidden class="fixed inset-0 z-[70] bg-[#14120e] text-[#ece5d2]">
  <div class="boot-screen flex h-full items-center justify-center px-5">
    <div class="w-full max-w-md">
      <div class="mb-5 flex items-center justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.3em] text-[#8f8670]">
        <span class="flex items-center gap-3">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--accent)]" style="animation: blink 1s steps(1) infinite"></span>
          QWARA TELESTATION · TAPE 01
        </span>
        <span class="phosphor text-[var(--accent)]" data-boot-phase>PHASE 01 // POWER</span>
      </div>

      <div class="font-mono text-xs leading-loose text-[#b8ae96] sm:text-sm" data-boot-log>
        <p data-boot-line="0" data-text={t('boot.line0')}></p>
        <p data-boot-line="1" data-text={t('boot.line1')}></p>
        <p data-boot-line="2" data-text={t('boot.line2')}></p>
        <p data-boot-line="3" data-text={t('boot.line3')}></p>
      </div>

      <p class="mt-5 font-mono text-xs font-bold tracking-widest text-[var(--accent)] phosphor" data-boot-status data-text={t('boot.status')}></p>

      <div class="mt-6 h-px bg-[#3a3529]">
        <div class="h-px origin-left bg-[var(--accent)]" style="transform: scaleX(0)" data-boot-bar></div>
      </div>
      <div class="mt-2 flex items-center justify-between font-mono text-[10px] tracking-widest text-[#8f8670]">
        <span class="flex items-center gap-4">
          <span>// LOADING TAPE</span>
          <span data-boot-tc>00:00:00:00</span>
        </span>
        <span class="flex items-center gap-4">
          <span class="boot-signal" data-boot-signal aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          <span data-boot-pct>0%</span>
        </span>
      </div>

      <p class="mt-8 text-center font-mono text-[10px] uppercase tracking-[0.25em] text-[#8f8670]/60" style="opacity: 0; transition: opacity 0.4s" data-boot-skip>
        {t('boot.skip')}
      </p>
    </div>
  </div>
  <!-- 上卷领边（胶片出带口） -->
  <div class="absolute left-0 right-0 h-[3px] bg-[var(--accent)]" style="top: 100%" data-boot-edge aria-hidden="true"></div>
</div>

<!-- 猫猫图标（导航栏品牌图标同款：橙色切角方块 + 猫猫）。
     与墨屏分离（fixed + 常驻渲染），进/退共用同一条 transform transition → 无缝衔接。
     载入时从右下角「推近」到舞台上中部，完成时「推远」归位右下角背景角标。
     默认即渲染为 Hero 背景角标；返回访问 / reduced-motion / 无 JS 时静止显示。 -->
<div class="boot-cat" data-boot-cat aria-hidden="true">
  <span class="boot-tile corner-cut"></span>
  <img src="/avatar.png" alt="" width="56" height="56" />
</div>

<style>
  /* 墨屏淡扫描线（单层；与全站 CRT 屏层呼应的屏内纹理） */
  [data-boot-overlay]::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(180deg, transparent 0 2px, rgba(0, 0, 0, 0.22) 2px 3px);
    pointer-events: none;
  }

  /* CRT 通电：内容面从高亮横线展开、亮度回落并两帧闪烁安定 */
  .boot-screen {
    animation: boot-power 0.55s var(--ease-out-expo) both;
  }
  @keyframes boot-power {
    0% { transform: scaleY(0.004); filter: brightness(2.8); opacity: 0.7; }
    45% { transform: scaleY(1); filter: brightness(1.6); opacity: 1; }
    58% { filter: brightness(1.05); }
    66% { filter: brightness(1.3); }
    100% { transform: scaleY(1); filter: brightness(1); opacity: 1; }
  }

  /* 离开：墨屏上卷，像胶片被抽出（领边带荧光） */
  [data-boot-edge] {
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 70%, transparent);
  }
  [data-boot-overlay].is-leaving {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-out);
  }
  [data-boot-overlay].is-leaving [data-boot-edge] {
    top: 0;
    transition: top 0.9s var(--ease-out);
  }
  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0.15; } }

  /* 信号锁定柱：依次点亮（stagger 走 transition-delay，非线性） */
  .boot-signal {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }
  .boot-signal i {
    width: 4px;
    height: 100%;
    background: var(--accent);
    opacity: 0.18;
    transform: scaleY(0.35);
    transform-origin: bottom;
    transition: transform 0.35s var(--ease-out), opacity 0.35s var(--ease-out);
  }
  .boot-signal i:nth-child(1) { height: 35%; }
  .boot-signal i:nth-child(2) { height: 50%; transition-delay: 0.07s; }
  .boot-signal i:nth-child(3) { height: 65%; transition-delay: 0.14s; }
  .boot-signal i:nth-child(4) { height: 82%; transition-delay: 0.21s; }
  .boot-signal i:nth-child(5) { height: 100%; transition-delay: 0.28s; }
  .boot-signal.is-locked i { opacity: 1; transform: scaleY(1); }

  /* 猫猫图标：同一元素在「角落角标」与「舞台中心」两态间切换，
     进/退共用同一条 transform transition → 完美衔接；非线性（--ease-out）。 */
  .boot-cat {
    position: fixed;
    left: 50%;
    top: 50%;
    width: 110px;
    height: 110px;
    z-index: 1; /* 背景角标：Hero 内容之下、光学层之上 */
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none; /* 纯装饰 */
    transform: translate(calc(-50% + 50vw - 64px), calc(-50% + 50vh - 200px)) scale(0.36);
    opacity: 0.4;
    transition: transform 0.9s var(--ease-out), opacity 0.9s var(--ease-out);
  }
  .boot-cat.boot-center {
    /* 中心 Y 由 JS 实测墨屏内容块上缘后写入 --boot-cat-offset（保证不压诊断文字） */
    transform: translate(-50%, calc(-50% - var(--boot-cat-offset, 16vh))) scale(1);
    opacity: 1;
  }
  .boot-cat .boot-tile {
    position: absolute;
    inset: 0;
    background: var(--accent);
  }
  .boot-cat img {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 2px;
  }
  @media (width < 760px) {
    .boot-cat {
      transform: translate(calc(-50% + 50vw - 48px), calc(-50% + 50vh - 150px)) scale(0.32);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* `?boot` 强制测试（html.boot-forced）时保留过渡，让猫猫照常滑入/归位 */
    html:not(.boot-forced) .boot-cat { transition: none; }
  }
</style>

<script>
  // BootOverlay lifecycle. Mirrors the standard init + astro:after-swap +
  // AbortController pattern. The replay guard is the `hero-booting` class: the
  // pre-paint gate in BaseLayout only adds it on a fresh first load, so any
  // view-transition return to home finds it absent and this no-ops.
  let bootAbort: AbortController | null = null;

  function initBoot() {
    bootAbort?.abort();
    bootAbort = new AbortController();
    const { signal } = bootAbort;

    const overlay = document.querySelector<HTMLElement>('[data-boot-overlay]');
    if (!overlay) return;
    if (!document.documentElement.classList.contains('hero-booting')) return;

    // Set the flag FIRST so a mid-boot navigation can never replay it.
    try {
      sessionStorage.setItem('qwara:booted', '1');
    } catch {
      /* storage unavailable — boot still plays this visit */
    }

    overlay.removeAttribute('hidden');
    const boot = overlay; // narrowed non-null alias for nested closures
    const bar = overlay.querySelector<HTMLElement>('[data-boot-bar]');
    const pct = overlay.querySelector<HTMLElement>('[data-boot-pct]');
    const status = overlay.querySelector<HTMLElement>('[data-boot-status]');
    const skipHint = overlay.querySelector<HTMLElement>('[data-boot-skip]');
    const phase = overlay.querySelector<HTMLElement>('[data-boot-phase]');
    const tc = overlay.querySelector<HTMLElement>('[data-boot-tc]');
    const sigLock = overlay.querySelector<HTMLElement>('[data-boot-signal]');
    const lines = Array.from(overlay.querySelectorAll<HTMLElement>('[data-boot-line]'));
    const statusText = status?.dataset.text ?? '';
    const cat = document.querySelector<HTMLElement>('[data-boot-cat]');

    const setPhase = (label: string) => {
      if (phase) phase.textContent = label;
    };

    // 中心落点：预填诊断行/状态到最终高度，同步测出内容块上缘（随后清空等打字机逐字渲染，
    // 首帧前完成，无闪烁），把猫猫中心推到内容上方（半猫高 55px + 留白 20px）。
    // 任意视口都不压诊断文字；写入 --boot-cat-offset 供 .boot-center 的 transform 使用。
    const contentBox = overlay.querySelector<HTMLElement>('.max-w-md');
    if (cat && contentBox) {
      const prior = lines.map((el) => el.textContent);
      lines.forEach((el) => (el.textContent = el.dataset.text || ''));
      if (status) status.textContent = statusText;
      // 不要用 getBoundingClientRect 量上缘：boot-power 的 scaleY(0.004) 会把
      // 内容压扁到视口中心，量出来 offset≈75 → 被夹到 120 下限 → 猫压住诊断文字。
      // offsetHeight 是布局高度（不受 transform 影响）；内容在墨屏里垂直居中，
      // 上缘 = (vh - 内容高)/2，于是 offset = 内容高/2 + 75（留白）。
      const contentH = contentBox.offsetHeight;
      lines.forEach((el, i) => (el.textContent = prior[i]));
      if (status) status.textContent = '';
      cat.style.setProperty(
        '--boot-cat-offset',
        `${Math.max(120, Math.round(contentH / 2 + 75))}px`,
      );
    }

    let finished = false;
    // 本 init 持有的全部定时器，finish() 与 abort 统一清理（修复 tcTimer 播完后
    // 永不清除的泄漏：它 25x/s 空转，首页整个会话都无法 idle）。
    const timers: number[] = [];
    const track = (t: number) => {
      timers.push(t);
      return t;
    };
    const clearTimers = () => {
      timers.forEach((t) => {
        window.clearTimeout(t);
        window.clearInterval(t);
      });
      timers.length = 0;
    };

    function finish() {
      if (finished) return;
      finished = true;
      clearTimers(); // 停掉进度/时码/打字机，防止它们继续写已退场的墨屏
      document.documentElement.classList.remove('hero-booting');
      // 交棒：让 Hero 开始解码（墨屏同时上卷露出）
      window.dispatchEvent(new CustomEvent('qw:boot-done'));
      boot.classList.add('is-leaving');
      track(window.setTimeout(() => boot.setAttribute('hidden', ''), 1000));
      // 猫猫归位：沿同一根 transform transition「推远」回右下角角标，与墨屏上卷同步；
      // 到位后 z-index 落回 1（此时已缩成角落小标，跳变不可见）。
      if (cat) {
        cat.classList.remove('boot-center');
        track(window.setTimeout(() => {
          if (cat) cat.style.zIndex = '';
        }, 900));
      }
    }

    // Skippable on any pointer/key.
    boot.addEventListener('pointerdown', finish, { once: true, signal });
    window.addEventListener('keydown', finish, { once: true, signal });
    signal.addEventListener('abort', finish);

    // 猫猫入场：CRT 通电展开后，从右下角角标「推近」到舞台上中部（finished 守卫：
    // 若极早跳过/导航，入场不得在归位后把猫猫再拉回中心）。
    track(window.setTimeout(() => {
      if (finished || !cat) return;
      cat.style.zIndex = '80'; // 压过墨屏 (z-70)；z 由 JS 接管，进/退方向延迟不同
      cat.classList.add('boot-center');
    }, 600));

    // 阶段编排：POWER（0，CSS 通电动画）→ SELF-TEST → TAPE LOAD → SIGNAL LOCK
    const start = performance.now();
    const BOOT_MS = 3400;
    const LOAD_START = 1500;
    const LOAD_SPAN = 1400;

    track(window.setTimeout(() => setPhase('PHASE 02 // SELF-TEST'), 450));
    track(window.setTimeout(() => setPhase('PHASE 03 // TAPE LOAD'), LOAD_START));
    track(window.setTimeout(() => {
      setPhase('PHASE 04 // SIGNAL LOCK');
      sigLock?.classList.add('is-locked');
    }, 2700));

    // Progress bar + percentage（TAPE LOAD 阶段 0 → 100，约 1.4s）
    const progressTimer = track(window.setInterval(() => {
      const el = performance.now() - start;
      if (el >= BOOT_MS) {
        window.clearInterval(progressTimer);
        finish();
        return;
      }
      const p = Math.min(1, Math.max(0, (el - LOAD_START) / LOAD_SPAN));
      if (bar) bar.style.transform = `scaleX(${p.toFixed(3)})`;
      if (pct) pct.textContent = `${Math.round(p * 100)}%`;
    }, 33));

    // 帧时码 HH:MM:SS:FF @25fps —— 磁带装载才走带；BootOverlay 自持 interval
    // （挂载顺序上 MotionBus 可能尚未初始化，不依赖 bus）
    let frames = 0;
    track(window.setInterval(() => {
      if (finished || performance.now() - start < LOAD_START || !tc) return;
      frames++;
      const pad = (n: number) => (n < 10 ? '0' : '') + n;
      const f = frames % 25;
      const s = Math.floor(frames / 25) % 60;
      const m = Math.floor(frames / 1500) % 60;
      const h = Math.floor(frames / 90000);
      tc.textContent = `${pad(h)}:${pad(m)}:${pad(s)}:${pad(f)}`;
    }, 40));

    // Typewriter reveal for each diagnostic line.
    const typeLine = (i: number, delay: number) =>
      track(window.setTimeout(() => {
        const el = lines[i];
        if (!el) return;
        const text = el.dataset.text || '';
        let ci = 0;
        const t = track(window.setInterval(() => {
          ci += 1;
          el.textContent = text.slice(0, ci);
          if (ci >= text.length) window.clearInterval(t);
        }, 22));
      }, delay));

    typeLine(0, 480);
    typeLine(1, 820);
    typeLine(2, 1160);
    typeLine(3, 1500);
    track(window.setTimeout(() => {
      if (status) status.textContent = statusText;
      if (skipHint) skipHint.style.opacity = '1';
    }, 3000));

    signal.addEventListener('abort', () => clearTimers());
  }

  initBoot();
  document.addEventListener('astro:after-swap', initBoot);
</script>
