---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const timeline = lang === 'zh'
  ? [
      { year: '现在', title: '和 AI 一起搭这个小站', desc: '本站就是 vibe coding 的产物 —— 一边问 AI 一边改，能跑起来就已经很开心了。' },
      { year: '最近', title: '开始写博客', desc: '试着把学到的小知识记下来，顺便强迫自己把东西想清楚。' },
      { year: '几个月前', title: '第一次做出能跑的东西', desc: '跟 AI 折腾了一个简单的网页，看到它在浏览器里打开的那一刻超兴奋。' },
      { year: '最初', title: '接触编程', desc: '在好奇心驱动下试着改了一个网页的样式，发现原来代码可以做东西。' },
    ]
  : [
      { year: 'Now', title: 'Vibe-coded this very site', desc: 'This site is a vibe-coding product—asking an AI and tweaking until it runs. Already a win.' },
      { year: 'Recently', title: 'Started writing blog posts', desc: 'Trying to jot down small things I have learned. Also a good excuse to think things through.' },
      { year: 'A few months ago', title: 'First thing that actually ran', desc: 'Built a tiny webpage with help from an AI. Seeing it open in the browser felt amazing.' },
      { year: 'The beginning', title: 'First time touching code', desc: 'Tweaked a webpage style out of curiosity, and realized code can actually make stuff.' },
    ];
---

<section id="timeline" class="golden-section border-t border-default relative">
  <div class="container-px container-mx">
    <div class="flex items-center gap-4 mb-phi-3">
      <span class="section-index">03 //</span>
      <p class="section-eyebrow mb-0!" >{t('timeline.eyebrow')}</p>
      <div class="schematic-line flex-1"></div>
    </div>

    <h2 class="section-title mb-phi-3 plate-heading">{t('timeline.title')}</h2>

    <div class="relative max-w-2xl">
      <div class="absolute left-[7px] sm:left-1/2 top-0 bottom-0 w-px bg-[var(--border)] overflow-hidden">
        <div class="absolute inset-0 bg-[var(--accent)] origin-top" style="transform: scaleY(0);" data-timeline-line></div>
      </div>

      <div class="space-y-phi-2">
        {timeline.map((item, i) => (
          <div
            class:list={[
              'relative flex items-start gap-phi-1',
              i % 2 === 0 ? 'sm:flex-row-reverse sm:text-right' : '',
            ]}

            data-reveal-delay={i * 0.12}
          >
            <div class="absolute left-0 sm:left-1/2 sm:-translate-x-1/2 w-3 h-3 mt-1.5 z-10" aria-hidden="true">
              <span class="absolute inset-0 rotate-45 border border-[var(--accent)]"></span>
              <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[2px] h-[2px] rounded-full bg-[var(--accent)]"></span>
            </div>
            <div class:list={['pl-12 sm:pl-0 sm:w-1/2', i % 2 === 0 ? 'sm:pr-12' : 'sm:pl-12']}>
              <span class="inline-flex items-center gap-2 font-mono text-xs font-bold text-[var(--accent)] mb-2">
                <span class="inline-block h-px w-4 bg-[var(--accent)] opacity-50" aria-hidden="true"></span>
                <span class="border border-[var(--border)] px-2 py-0.5 corner-cut text-[10px] tracking-wider bg-[var(--bg-elev)]" style="--corner-cut: 5px">{item.year}</span>
              </span>
              <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
              <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Draw the accent timeline line top-to-bottom when it scrolls into view.
  function initTimelineLine() {
    document.querySelectorAll('[data-timeline-line]').forEach((line) => {
      if ((line as HTMLElement).dataset.initialized) return;
      (line as HTMLElement).dataset.initialized = 'true';

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).style.transform = 'scaleY(1)';
              (entry.target as HTMLElement).style.transition = 'transform 1.5s var(--ease-out)';
              io.disconnect();
            }
          });
        },
        { rootMargin: '0px 0px -25% 0px' },
      );
      io.observe(line);
    });
  }

  initTimelineLine();
  document.addEventListener('astro:after-swap', initTimelineLine);
</script>
