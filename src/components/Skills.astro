---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skillGroups = lang === 'zh'
  ? [
      { name: '前端', skills: [{ name: 'HTML / CSS', level: 45 }, { name: 'JavaScript', level: 30 }, { name: '跟着 AI 写 React', level: 25 }, { name: '复制粘贴 Tailwind', level: 40 }] },
      { name: '工具', skills: [{ name: 'VS Code', level: 60 }, { name: 'Git（基本 add/commit）', level: 20 }, { name: '浏览器 DevTools', level: 35 }] },
      { name: '其它', skills: [{ name: '跟 AI 聊聊', level: 95 }, { name: 'Ctrl + C / V', level: 99 }, { name: '耐心 debug', level: 50 }] },
    ]
  : [
      { name: 'Frontend', skills: [{ name: 'HTML / CSS', level: 45 }, { name: 'JavaScript', level: 30 }, { name: 'React (with AI)', level: 25 }, { name: 'Tailwind (copy-paste)', level: 40 }] },
      { name: 'Tools', skills: [{ name: 'VS Code', level: 60 }, { name: 'Git (basic add/commit)', level: 20 }, { name: 'Browser DevTools', level: 35 }] },
      { name: 'Misc', skills: [{ name: 'Asking the AI', level: 95 }, { name: 'Ctrl + C / V', level: 99 }, { name: 'Debugging patience', level: 50 }] },
    ];
---

<section id="skills" class="golden-section border-t border-default relative">
  <div class="container-px container-mx">
    <div class="flex items-center gap-4 mb-phi-1">
      <span class="section-index">02 //</span>
      <p class="section-eyebrow mb-0!">{t('skills.eyebrow')}</p>
      <div class="schematic-line flex-1"></div>
    </div>

    <h2 class="section-title mb-3 plate-heading">{t('skills.title')}</h2>

    <p class="text-muted mb-phi-2 readout">{t('skills.subtitle')}</p>

    <div class="grid md:grid-cols-3 gap-phi-1">
      {skillGroups.map((group, gi) => (
        <div
          class="card p-phi-1 h-full rounded-[4px] relative"
        >
          <div class="flex items-center justify-between mb-phi-1">
            <h3 class="inline-flex items-center gap-2 text-sm font-mono uppercase tracking-wider text-[var(--accent)]">
              <span class="inline-block w-2 h-2 bg-[var(--accent)]" aria-hidden="true"></span>
              {group.name}
            </h3>
            <span class="font-mono text-[10px] text-muted opacity-60" aria-hidden="true">0{gi + 1}</span>
          </div>

          <div class="space-y-3">
            {group.skills.map((skill) => (
              <div>
                <div class="flex items-center justify-between text-xs mb-1.5">
                  <span class="text-muted">{skill.name}</span>
                  <span class="font-mono text-muted opacity-70">{skill.level}%</span>
                </div>
                <div class="h-1.5 rounded-full bg-[var(--border)] overflow-hidden">
                  <div class="h-full bg-[var(--accent)]" style={{ width: `${skill.level}%` }}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
