---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import GithubIcon from '@components/icons/GithubIcon.astro';
import pkg from '../../package.json' with { type: 'json' };

interface Props {
  lang?: Lang;
  totalPosts?: number;
  totalWords?: number;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const version = pkg.version;
const { totalPosts = 0, totalWords = 0 } = Astro.props;

const socials = [
  { label: 'GitHub', href: 'https://github.com/Qwara-chan', icon: 'github' },
  { label: 'RSS', href: getLocalizedPath('rss.xml', lang), icon: 'rss' },
];
---

<footer class="border-t border-default mt-phi-4 relative">
  <!-- 顶缘 VHS 三色条 -->
  <div class="vhsbar thin absolute inset-x-0 top-0" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <div class="container-px container-mx py-phi-2">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <span class="relative inline-flex w-9 h-9 items-center justify-center shrink-0">
          <span class="absolute inset-0 bg-[var(--accent)] corner-cut"></span>
          <img
            src="/avatar.png"
            alt=""
            class="relative w-5 h-5 rounded-[1px]"
            width="20"
            height="20"
          />
        </span>
        <div class="text-sm leading-tight">
          <span class="font-display text-base tracking-tight">QWARA</span>
          <span class="text-muted ml-2 text-xs">&copy; {year} {t('footer.rights')}</span>
          <span class="text-muted ml-2 font-mono text-xs">v{version}</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            target={s.icon === 'rss' ? undefined : '_blank'}
            rel={s.icon === 'rss' ? undefined : 'noopener noreferrer'}
            class="flex items-center justify-center w-9 h-9 rounded-[4px] border border-default text-muted hover:text-[var(--accent)] hover:border-[var(--accent)] transition-all duration-300 hover:-translate-y-0.5"
            aria-label={s.label}
            {...(s.icon === 'rss' ? { 'data-astro-reload': '' } : {})}
          >
            {s.icon === 'github' && (
              <GithubIcon class="w-4 h-4" />
            )}
            {s.icon === 'rss' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-phi-1 pt-phi-1 border-t border-default text-center text-xs text-muted readout">
      <span>{t('footer.builtWith')}</span>
      {totalPosts > 0 && (
        <>
          <span class="mx-2 opacity-30">|</span>
          <span>{totalPosts} {t('footer.totalPosts')} · {totalWords.toLocaleString()} {t('footer.totalWords')}</span>
        </>
      )}
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 font-mono text-[9px] tracking-[0.2em] uppercase text-muted">
      <span class="inline-flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 bg-[var(--accent)]"></span>
        QWARA RESEARCH ARCHIVE · EST. 1987
      </span>
      <span class="inline-flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5 text-[var(--accent)] phosphor" data-sys-chip>
          <span class="inline-block w-1 h-1 rounded-full bg-current" style="animation: sys-blink 1.6s steps(1) infinite"></span>
          SYS · ONLINE
        </span>
        <span data-utc-clock>00:00:00 UTC</span>
        <span>PAGE ∞ · {year}</span>
      </span>
    </div>
  </div>
</footer>

<style>
  @keyframes sys-blink {
    0%, 70% { opacity: 1; }
    71%, 100% { opacity: 0.2; }
  }
</style>

<script>
  // 页脚 UTC 实时钟（标准 init + after-swap + AbortController 模式）。
  let sysAbort: AbortController | null = null;

  function initSysStatus() {
    sysAbort?.abort();
    sysAbort = new AbortController();
    const { signal } = sysAbort;
    const clock = document.querySelector<HTMLElement>('[data-utc-clock]');
    if (!clock) return;
    const pad = (n: number) => (n < 10 ? '0' : '') + n;
    const tick = () => {
      const d = new Date();
      clock.textContent = `${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())} UTC`;
    };
    tick();
    const t = window.setInterval(tick, 1000);
    signal.addEventListener('abort', () => window.clearInterval(t));
  }

  initSysStatus();
  document.addEventListener('astro:after-swap', initSysStatus);
</script>
