---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import pkg from '../../package.json' with { type: 'json' };

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const version = pkg.version;

const socials = [
  { label: 'GitHub', href: 'https://github.com/Qwara-chan', icon: 'github' },
  { label: 'RSS', href: getLocalizedPath('rss.xml', lang), icon: 'rss' },
];
---

<footer class="border-t border-default mt-phi-4">
  <div class="container-px container-mx py-phi-2">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <img
          src="/avatar.png"
          alt=""
          class="w-7 h-7 rounded-lg"
          width="28"
          height="28"
        />
        <div class="text-sm">
          <span class="font-semibold">Qwara</span>
          <span class="text-muted ml-2">&copy; {year} {t('footer.rights')}</span>
          <span class="text-muted ml-2 font-mono" style="opacity: 0.35;">v{version}</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            target={s.icon === 'rss' ? undefined : '_blank'}
            rel={s.icon === 'rss' ? undefined : 'noopener noreferrer'}
            class="flex items-center justify-center w-9 h-9 rounded-full border border-default text-muted hover:text-[var(--fg)] hover:border-strong transition-all duration-300 hover:-translate-y-0.5"
            aria-label={s.label}
          >
            {s.icon === 'github' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
            )}
            {s.icon === 'rss' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-phi-1 pt-phi-1 border-t border-default text-center text-xs text-muted">
      {t('footer.builtWith')}
    </div>
  </div>
</footer>
