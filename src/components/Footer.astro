---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import GithubIcon from '@components/icons/GithubIcon.astro';
import pkg from '../../package.json' with { type: 'json' };

interface Props {
  lang?: Lang;
  totalPosts?: number;
  totalWords?: number;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const version = pkg.version;
const { totalPosts = 0, totalWords = 0 } = Astro.props;

const socials = [
  { label: 'GitHub', href: 'https://github.com/Qwara-chan', icon: 'github' },
  { label: 'RSS', href: getLocalizedPath('rss.xml', lang), icon: 'rss' },
];
---

<footer class="border-t border-default mt-phi-4 relative">
  {/* Caution-stripe hazard band on top */}
  <div class="hazard-band absolute inset-x-0 top-0 h-[3px]" style="--hazard-color: var(--accent); --hazard-opacity: 0.5;" aria-hidden="true"></div>

  <div class="container-px container-mx py-phi-2">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <img
          src="/avatar.png"
          alt=""
          class="w-7 h-7 rounded-[4px] border border-default"
          width="28"
          height="28"
        />
        <div class="text-sm">
          <span class="font-semibold font-mono">QWARA</span>
          <span class="text-muted ml-2">&copy; {year} {t('footer.rights')}</span>
          <span class="text-muted ml-2 font-mono" style="opacity: 0.35;">v{version}</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            target={s.icon === 'rss' ? undefined : '_blank'}
            rel={s.icon === 'rss' ? undefined : 'noopener noreferrer'}
            class="flex items-center justify-center w-9 h-9 rounded-[4px] border border-default text-muted hover:text-[var(--accent)] hover:border-[var(--accent)] transition-all duration-300 hover:-translate-y-0.5"
            aria-label={s.label}
          >
            {s.icon === 'github' && (
              <GithubIcon class="w-4 h-4" />
            )}
            {s.icon === 'rss' && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" /></svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-phi-1 pt-phi-1 border-t border-default text-center text-xs text-muted readout">
      <span>{t('footer.builtWith')}</span>
      <button
        type="button"
        class="footer-meow inline-flex items-center align-middle ml-1"
        data-footer-meow
        aria-label="meow~"
        title="meow~"
      >🐾</button>
      {totalPosts > 0 && (
        <>
          <span class="mx-2 opacity-30">|</span>
          <span>{totalPosts} {t('footer.totalPosts')} · {totalWords.toLocaleString()} {t('footer.totalWords')}</span>
        </>
      )}
    </div>
  </div>
</footer>
