---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import { getPosts, getAllTags, vtTag } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPosts = await getPosts(lang);
const tags = await getAllTags(allPosts);

const maxCount = Math.max(...tags.map((x) => x.count), 1);
const tagsBase = getLocalizedPath('tags', lang);
const blogBase = getLocalizedPath('blog', lang);

// Continuous size scale: 0.9rem (smallest) → 2.9rem (largest)
function tagSize(count: number): string {
  const ratio = count / maxCount;
  return `${(0.9 + ratio * 2.0).toFixed(3)}rem`;
}
function tagOpacity(count: number): number {
  const ratio = count / maxCount;
  return 0.55 + ratio * 0.45;
}
---

<BaseLayout title={t('tagsCloud.title')} description={t('tagsCloud.subtitle')}>
  <div class="container-px container-mx golden-section" data-section-reveal>
    <a href={blogBase} class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-[var(--fg)] transition-colors duration-300 mb-6 font-mono">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7M19 12H5" /></svg>
      {t('blog.back')}
    </a>
    <div class="flex items-center gap-4 mb-3" transition:name="qc-page-head" data-vt>
      <span class="section-index">T//</span>
      <p class="section-eyebrow mb-0!" data-scroll-skew data-skew-angle="8deg">{t('tagsCloud.eyebrow')}</p>
      <div class="schematic-line flex-1"></div>
    </div>
    <h1 class="font-display text-4xl sm:text-5xl font-black tracking-tight mb-3">{t('tagsCloud.title')}</h1>
    <p class="text-muted mb-phi-2 readout">
      {t('tagsCloud.subtitle')}
      <span class="ml-2 font-mono text-sm text-[var(--accent)]">
        {tags.length} {t('tagsCloud.countUnit')}
      </span>
    </p>

    {tags.length > 0 ? (
      <div class="relative max-w-3xl mx-auto">
        {/* Ghost T — 视差水印 */}
        <span
          class="ghost-numeral right-0 top-6 text-[clamp(6rem,18vw,13rem)]"
          data-parallax
          data-parallax-speed="0.06"
          aria-hidden="true"
        >T</span>
        <div class="relative flex flex-wrap items-center gap-x-4 gap-y-3 justify-center py-phi-2" data-scroll-fade>
          {tags.map(({ tag, count }) => (
            <a
              href={`${tagsBase}/${encodeURIComponent(tag)}`}
              class="inline-block font-bold tracking-tight transition-all duration-300 hover:scale-110 hover:text-[var(--accent)] font-mono"
              style={`font-size: ${tagSize(count)}; opacity: ${tagOpacity(count)};`}
              transition:name={`qc-tagword-${vtTag(tag)}`}
            >
              {tag}
              <sup class="text-xs font-mono ml-0.5" style="opacity: 0.5;">{count}</sup>
            </a>
          ))}
        </div>
      </div>
    ) : (
      <div class="text-center py-20 text-muted">
        <p class="text-lg">{t('blog.noPosts')}</p>
      </div>
    )}
  </div>
</BaseLayout>
