---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import About from '@components/About.astro';
import Skills from '@components/Skills.astro';
import Timeline from '@components/Timeline.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import BlogCard from '@components/BlogCard.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import { getPosts, getProjects } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = (await getPosts(lang)).slice(0, 3);
const projects = (await getProjects(lang)).slice(0, 4);
---

<BaseLayout>
  <Hero lang={lang} />
  <About lang={lang} />
  <Skills lang={lang} />
  <Timeline lang={lang} />

{posts.length > 0 && (
  <section class="golden-section border-t border-default relative" data-section-reveal>
    <div class="container-px container-mx">
      <div class="flex items-end justify-between mb-phi-2">
        <div>
          <div class="flex items-center gap-4 mb-2">
            <span class="section-index">04 //</span>
            <p class="section-eyebrow mb-0!">{t('blog.eyebrow')}</p>
          </div>
          <h2 class="section-title" data-scroll-fade data-scroll-fade-y="12px">{t('blog.title')}</h2>
        </div>
        <a href={getLocalizedPath('blog', lang)} class="text-sm link-underline whitespace-nowrap font-mono">
          {t('projects.viewAll')}
          <span class="ml-1">&rarr;</span>
        </a>
      </div>

      <StaggerGrid class="grid md:grid-cols-2 lg:grid-cols-3 gap-phi-1">
        {posts.map((post) => (
          <BlogCard post={post} lang={lang} />
        ))}
      </StaggerGrid>
    </div>
  </section>
)}

{projects.length > 0 && (
  <section class="golden-section border-t border-default relative" data-section-reveal>
    <div class="container-px container-mx">
      <div class="flex items-end justify-between mb-phi-2">
        <div>
          <div class="flex items-center gap-4 mb-2">
            <span class="section-index">05 //</span>
            <p class="section-eyebrow mb-0!">{t('projects.eyebrow')}</p>
          </div>
          <h2 class="section-title" data-scroll-fade data-scroll-fade-y="12px">{t('projects.title')}</h2>
        </div>
        <a href={getLocalizedPath('projects', lang)} class="text-sm link-underline whitespace-nowrap font-mono">
          {t('projects.viewAll')}
          <span class="ml-1">&rarr;</span>
        </a>
      </div>

      <StaggerGrid class="grid sm:grid-cols-2 lg:grid-cols-2 gap-phi-1">
        {projects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </StaggerGrid>
    </div>
  </section>
)}
</BaseLayout>
