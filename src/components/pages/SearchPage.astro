---
import BaseLayout from '@layouts/BaseLayout.astro';
import ScrollReveal from '@components/animations/ScrollReveal.astro';
import BlogCard from '@components/BlogCard.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getPosts } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPosts = await getPosts(lang);
---

<BaseLayout title={t('nav.search')} description={t('blog.search')}>
  <div class="container-px container-mx golden-section">
    <ScrollReveal>
      <p class="section-eyebrow">{t('nav.search')}</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-3">{t('nav.search')}</h1>
      <p class="text-muted mb-10">{t('blog.search')}</p>
    </ScrollReveal>

    <div class="relative mb-10" data-search-root>
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
      <input
        type="search"
        id="search-input"
        placeholder={t('blog.search')}
        class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-[var(--bg-elev)] border border-default text-base focus:outline-none focus:border-[var(--accent)] transition-colors"
        autocomplete="off"
      />
    </div>

    <div id="search-status" class="text-sm text-muted mb-6 hidden" data-results-suffix={t('blog.resultsCount')}></div>

    <div id="search-results" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allPosts.map((post) => {
        const haystack = (
          post.data.title + ' ' + post.data.description + ' ' + post.data.tags.join(' ')
        ).toLowerCase();
        const titleHay = post.data.title.toLowerCase();
        const tagsHay = post.data.tags.map((tag) => tag.toLowerCase()).join(',');
        return (
          <article
            data-search-key={haystack}
            data-search-title={titleHay}
            data-search-tags={tagsHay}
          >
            <BlogCard post={post} lang={lang} />
          </article>
        );
      })}
    </div>

    <div id="search-empty" class="hidden text-center py-16 text-muted" data-empty={t('blog.noResults')}>
      <p class="text-5xl mb-4">🐾</p>
      <p>{t('blog.noResults')}</p>
    </div>
  </div>
</BaseLayout>

<script>
  // Per-init AbortController: the [data-search-key] elements differ across
  // navigations, so we re-collect them and tear down any old listeners.
  // The input handler also coalesces via rAF so fast typing does not run
  // score() against every post on every keystroke.
  let searchAbort: AbortController | null = null;

  function initSearch() {
    searchAbort?.abort();
    searchAbort = new AbortController();
    const { signal } = searchAbort;

    const input = document.getElementById('search-input') as HTMLInputElement;
    const results = document.getElementById('search-results') as HTMLElement;
    const empty = document.getElementById('search-empty') as HTMLElement;
    const status = document.getElementById('search-status') as HTMLElement;
    if (!input || !results || !empty || !status) return;

    const items = Array.from(results.querySelectorAll<HTMLElement>('article[data-search-key]'));
    const emptyLabel = empty.dataset.empty || '';
    // results-count suffix comes from the rendered i18n label (e.g. "个结果" / "results")
    const resultsSuffix = status.dataset.resultsSuffix || 'results';

    function score(el: HTMLElement, q: string): number {
      const key = el.dataset.searchKey || '';
      const title = el.dataset.searchTitle || '';
      const tags = (el.dataset.searchTags || '').split(',').filter(Boolean);
      if (key.includes(q)) {
        let s = 1;
        if (title.includes(q)) s += 2;
        if (tags.some((tag) => tag.includes(q))) s += 1;
        return s;
      }
      const tokens = q.split(/\s+/).filter(Boolean);
      if (tokens.length === 0) return 0;
      let hit = 0;
      for (const tk of tokens) if (key.includes(tk)) hit += 1;
      return hit === tokens.length ? hit / tokens.length : 0;
    }

    function clearGrid() {
      items.forEach((el) => { el.hidden = false; el.style.order = ''; });
    }

    // Highlight matched keywords in titles and descriptions
    function highlight(el: HTMLElement | null, q: string) {
      if (!el) return;
      if (!el.dataset.original) el.dataset.original = el.textContent || '';
      const text = el.dataset.original;
      if (!q) {
        el.textContent = text;
        return;
      }
      const tokens = q.split(/\s+/).filter(Boolean).map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      if (tokens.length === 0) {
        el.textContent = text;
        return;
      }
      const re = new RegExp(`(${tokens.join('|')})`, 'gi');
      el.innerHTML = text.replace(re, '<mark class="search-mark">$1</mark>');
    }

    // rAF-coalesce: at most one run per animation frame. Subsequent input events
    // bump `pendingQuery` and let the next frame pick it up.
    let pendingQuery: string | null = null;
    let frameQueued = false;
    const runUpdate = () => {
      frameQueued = false;
      const q = pendingQuery ?? '';
      pendingQuery = null;
      render(q);
    };

    function render(q: string) {
      if (!q) {
        clearGrid();
        items.forEach((el) => {
          highlight(el.querySelector('h3'), '');
          highlight(el.querySelector('p.line-clamp-2'), '');
        });
        results.classList.remove('hidden');
        empty.classList.add('hidden');
        status.classList.add('hidden');
        return;
      }

      const scored = items
        .map((el) => ({ el, s: score(el, q) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s);
      const matched = new Set(scored.map((x) => x.el));
      items.forEach((el) => {
        el.hidden = !matched.has(el);
        highlight(el.querySelector('h3'), q);
        highlight(el.querySelector('p.line-clamp-2'), q);
      });
      scored.forEach((x, i) => { x.el.style.order = String(i); });

      if (scored.length === 0) {
        results.classList.add('hidden');
        empty.classList.remove('hidden');
        status.classList.remove('hidden');
        status.textContent = emptyLabel;
      } else {
        results.classList.remove('hidden');
        empty.classList.add('hidden');
        status.classList.remove('hidden');
        status.textContent = String(scored.length) + ' ' + resultsSuffix;
      }
    }

    input.addEventListener(
      'input',
      () => {
        const q = (input.value || '').trim().toLowerCase();
        // Empty query is already trivial — render synchronously so the grid
        // returns immediately when the user clears the field.
        if (!q) {
          pendingQuery = null;
          render('');
          return;
        }
        pendingQuery = q;
        if (!frameQueued) {
          frameQueued = true;
          requestAnimationFrame(runUpdate);
        }
      },
      { signal }
    );

    render((input.value || '').trim().toLowerCase());
    // Pre-fill from ?q= (e.g. coming from the 404 search box)
    const qParam = new URLSearchParams(window.location.search).get('q');
    if (qParam && !input.value) {
      input.value = qParam;
      render(qParam.trim().toLowerCase());
    }
    // Focus the input, except on touch devices where that would pop the
    // soft keyboard immediately (unless we already have a ?q= to act on).
    const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;
    if ((!isCoarsePointer || qParam) && document.activeElement !== input) {
      setTimeout(() => input.focus(), 100);
    }
  }

  initSearch();
  document.addEventListener('astro:after-swap', initSearch);
</script>
