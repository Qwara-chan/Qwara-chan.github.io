---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import ScrollReveal from '@components/animations/ScrollReveal.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getProjects } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<BaseLayout title={t('projects.title')} description={t('projects.subtitle')}>
  <div class="container-px container-mx golden-section">
    <ScrollReveal>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-3">
        <div>
          <p class="section-eyebrow">{t('projects.eyebrow')}</p>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">{t('projects.title')}</h1>
        </div>
        <a
          href="https://github.com/Qwara-chan"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-[var(--accent)] transition-colors duration-300 self-start sm:self-end"
        >
          <GithubIcon class="w-4 h-4" />
          {t('projects.viewOnGithub')}
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <p class="text-muted mb-2">{t('projects.subtitle')}</p>
      <p class="text-xs font-mono text-muted mb-phi-2 inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        {t('projects.syncedFromGithub')} · {projects.length} {t('projects.repoCount')}
      </p>
    </ScrollReveal>

    {projects.length > 0 ? (
      <StaggerGrid class="grid sm:grid-cols-2 gap-phi-1">
        {projects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </StaggerGrid>
    ) : (
      <div class="text-center py-20 text-muted">
        <p class="text-lg">{t('blog.noPosts')}</p>
      </div>
    )}
  </div>
</BaseLayout>
