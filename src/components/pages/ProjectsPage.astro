---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import ScrollReveal from '@components/animations/ScrollReveal.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getProjects } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<BaseLayout title={t('projects.title')} description={t('projects.subtitle')}>
  <div class="container-px container-mx golden-section">
    <ScrollReveal>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-3">
        <div>
          <p class="section-eyebrow">{t('projects.eyebrow')}</p>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">{t('projects.title')}</h1>
        </div>
        <a
          href="https://github.com/Qwara-chan"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-[var(--accent)] transition-colors duration-300 self-start sm:self-end"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          {t('projects.viewOnGithub')}
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <p class="text-muted mb-2">{t('projects.subtitle')}</p>
      <p class="text-xs font-mono text-muted mb-12 inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        {t('projects.syncedFromGithub')} · {projects.length} {t('projects.repoCount')}
      </p>
    </ScrollReveal>

    {projects.length > 0 ? (
      <StaggerGrid class="grid sm:grid-cols-2 gap-6">
        {projects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </StaggerGrid>
    ) : (
      <div class="text-center py-20 text-muted">
        <p class="text-lg">{t('blog.noPosts')}</p>
      </div>
    )}
  </div>
</BaseLayout>
