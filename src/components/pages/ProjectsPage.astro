---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import ScrollReveal from '@components/animations/ScrollReveal.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getProjects } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects(lang);

// Unique languages for the filter toolbar
const languages = [...new Set(projects.map((p) => p.data.language).filter(Boolean))] as string[];
---

<BaseLayout title={t('projects.title')} description={t('projects.subtitle')}>
  <div class="container-px container-mx golden-section">
    <ScrollReveal>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-3">
        <div>
          <p class="section-eyebrow">{t('projects.eyebrow')}</p>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">{t('projects.title')}</h1>
        </div>
        <a
          href="https://github.com/Qwara-chan"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-muted hover:text-[var(--accent)] transition-colors duration-300 self-start sm:self-end"
        >
          <GithubIcon class="w-4 h-4" />
          {t('projects.viewOnGithub')}
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <p class="text-muted mb-2">{t('projects.subtitle')}</p>
      <p class="text-xs font-mono text-muted mb-phi-2 inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        {t('projects.syncedFromGithub')} · {projects.length} {t('projects.repoCount')}
      </p>
    </ScrollReveal>

    {projects.length > 0 ? (
      <div data-project-container>
        <div class="flex flex-wrap items-center gap-3 mb-phi-2" data-project-toolbar>
          <div class="flex flex-wrap gap-2" data-project-langs>
            <button class="tag-chip tag-chip-active" data-lang-filter="">
              {t('projects.allLangs')}
            </button>
            {languages.map((l) => (
              <button class="tag-chip" data-lang-filter={l}>
                {l}
              </button>
            ))}
          </div>
          <div class="flex flex-wrap gap-2 sm:ml-auto" data-project-sort>
            <button class="tag-chip tag-chip-active" data-sort="updated">
              {t('projects.sortUpdated')}
            </button>
            <button class="tag-chip" data-sort="stars">
              {t('projects.sortStars')}
            </button>
            <button class="tag-chip" data-sort="forks">
              {t('projects.sortForks')}
            </button>
          </div>
        </div>

        <StaggerGrid class="grid sm:grid-cols-2 gap-phi-1">
          {projects.map((project) => (
            <div
              data-project-item
              data-lang={project.data.language ?? ''}
              data-stars={project.data.stars}
              data-forks={project.data.forks}
              data-updated={new Date(project.data.pushedAt ?? project.data.updatedAt ?? 0).getTime()}
            >
              <ProjectCard project={project} lang={lang} />
            </div>
          ))}
        </StaggerGrid>
      </div>
    ) : (
      <div class="text-center py-20 text-muted">
        <p class="text-lg">{t('blog.noPosts')}</p>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  // Client-side language filter + sort for the projects grid. Each card is
  // wrapped with data attributes so we can reorder via CSS `order` without
  // touching the DOM tree (keeps the stagger animation intact).
  let projAbort: AbortController | null = null;

  function initProjects() {
    projAbort?.abort();
    projAbort = new AbortController();
    const { signal } = projAbort;

    const toolbar = document.querySelector('[data-project-toolbar]');
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-project-item]'));
    if (!toolbar || !items.length) return;
    const langBtns = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-lang-filter]'));
    const sortBtns = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('[data-sort]'));
    if (!items.length) return;

    let activeLang = '';
    let activeSort = 'updated';

    function apply() {
      const visible = items.filter((el) => {
        const lang = el.dataset.lang || '';
        return !activeLang || lang === activeLang;
      });
      const visibleSet = new Set(visible);
      items.forEach((el) => { el.hidden = !visibleSet.has(el); });

      visible.sort((a, b) => {
        if (activeSort === 'stars') return parseInt(b.dataset.stars || '0') - parseInt(a.dataset.stars || '0');
        if (activeSort === 'forks') return parseInt(b.dataset.forks || '0') - parseInt(a.dataset.forks || '0');
        return parseInt(b.dataset.updated || '0') - parseInt(a.dataset.updated || '0');
      });
      visible.forEach((el, i) => { el.style.order = String(i); });
    }

    langBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeLang = btn.dataset.langFilter || '';
        langBtns.forEach((b) => b.classList.toggle('tag-chip-active', b === btn));
        apply();
      }, { signal });
    });

    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeSort = btn.dataset.sort || 'updated';
        sortBtns.forEach((b) => b.classList.toggle('tag-chip-active', b === btn));
        apply();
      }, { signal });
    });
  }

  initProjects();
  document.addEventListener('astro:after-swap', initProjects);
</script>
