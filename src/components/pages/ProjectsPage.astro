---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getProjects } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = await getProjects(lang);
const githubUrl = 'https://github.com/Qwara-chan';
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={t('projects.title')} description={t('projects.subtitle')}>
  <header class="relative border-b border-default">
    <div class="container-px container-mx w-full pb-phi-3 pt-24">
      <div class="mb-2 flex items-center gap-4">
        <span class="section-index">P//</span>
        <p class="section-eyebrow mb-0!">{t('projects.eyebrow')}</p>
      </div>

      <h1 class="type-phi-name">{t('projects.title')}</h1>

      <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
        <p class="max-w-xl leading-relaxed text-muted">{t('projects.subtitle')}</p>
        <p class="readout inline-flex items-center gap-2 whitespace-nowrap">
          <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-[var(--accent)]"></span>
          RECORDS <span>{pad(projects.length)}</span>
          <span class="opacity-50">{t('projects.records')}</span>
        </p>
      </div>
    </div>
  </header>

  {projects.length > 0 && (
    <section class="container-px container-mx py-phi-3">
      <StaggerGrid class="grid gap-phi-1 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project, i) => (
          <ProjectCard project={project} lang={lang} index={i} />
        ))}
      </StaggerGrid>
    </section>
  )}

  <div class="container-px container-mx py-phi-2">
    <div class="schematic-line mb-phi-1"></div>
    <p class="readout mb-phi-1">{t('projects.endOfFile')}</p>
    <a
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors duration-300 hover:text-[var(--accent)]"
    >
      <GithubIcon class="h-4 w-4" />
      {t('projects.viewOnGithub')}
      <span>&rarr;</span>
    </a>
  </div>
</BaseLayout>
