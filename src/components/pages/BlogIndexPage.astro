---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogCard from '@components/BlogCard.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import { getPosts, getAllTags, paginate, vtTag } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPosts = await getPosts(lang);
const allTags = await getAllTags(allPosts);

const pageSize = 9;
const pages = paginate(allPosts, pageSize);
const totalPages = pages.length;

const pageParam = Astro.url.searchParams.get('page') ?? '1';
const urlPage = /^\d+$/.test(pageParam) ? Number(pageParam) : NaN;
const currentPage = Number.isFinite(urlPage) ? Math.min(Math.max(1, urlPage), totalPages) : 1;
const posts = pages[currentPage - 1] ?? [];

const blogBase = getLocalizedPath('blog', lang);
const tagsBase = getLocalizedPath('tags', lang);
---

<BaseLayout title={t('blog.title')} description={t('blog.subtitle')}>
  <div class="container-px container-mx golden-section">
    <div>
      <div class="flex items-center gap-4 mb-3" transition:name="qc-page-head" data-vt>
        <span class="section-index">B//</span>
        <p class="section-eyebrow mb-0!">{t('blog.eyebrow')}</p>
        <div class="schematic-line flex-1"></div>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-black tracking-tight mb-3">{t('blog.title')}</h1>
      <p class="text-muted mb-phi-2 readout">{t('blog.subtitle')}</p>
    </div>

    {allTags.length > 0 && (
      <div class="flex flex-wrap gap-2 items-center py-2 mb-phi-1">
        <a href={blogBase} class="tag-chip tag-chip-active font-mono">
          {t('blog.allTags')}
        </a>
        {allTags.map(({ tag, count }) => (
          <a
            href={`${tagsBase}/${encodeURIComponent(tag)}`}
            class="tag-chip font-mono"
            transition:name={`qc-tagword-${vtTag(tag)}`}
          >
            #{tag} <span class="opacity-50 ml-1">{count}</span>
          </a>
        ))}
        <a href={tagsBase} class="tag-chip ml-auto whitespace-nowrap font-mono">
          ☁ {t('tagsCloud.title')}
        </a>
      </div>
    )}

    <div class="pt-phi-1">
      {posts.length > 0 ? (
        <StaggerGrid class="grid md:grid-cols-2 lg:grid-cols-3 gap-phi-1">
          {posts.map((post) => (
            <BlogCard post={post} lang={lang} />
          ))}
        </StaggerGrid>
      ) : (
        <div class="text-center py-20 text-muted">
          <p class="text-lg">{t('blog.noPosts')}</p>
        </div>
      )}

      {totalPages > 1 && (
        <div class="flex items-center justify-center gap-2 mt-phi-2">
          {currentPage > 1 && (
            <a href={`${blogBase}?page=${currentPage - 1}`} class="btn btn-ghost">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
              {t('blog.prev')}
            </a>
          )}
          <span class="px-4 py-2 text-sm text-muted font-mono">
            {currentPage} / {totalPages}
          </span>
          {currentPage < totalPages && (
            <a href={`${blogBase}?page=${currentPage + 1}`} class="btn btn-ghost">
              {t('blog.next')}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
