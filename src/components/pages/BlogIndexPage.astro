---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogCard from '@components/BlogCard.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import ScrollReveal from '@components/animations/ScrollReveal.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import { getPosts, getAllTags, paginate } from '@utils/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPosts = await getPosts(lang);
const allTags = await getAllTags(lang);

const pageSize = 9;
const pages = paginate(allPosts, pageSize);
const totalPages = pages.length;

const urlPage = parseInt(Astro.url.searchParams.get('page') || '1');
const currentPage = Math.min(Math.max(1, urlPage), totalPages);
const posts = pages[currentPage - 1] ?? [];

const blogBase = getLocalizedPath('blog', lang);
const tagsBase = getLocalizedPath('tags', lang);
---

<BaseLayout title={t('blog.title')} description={t('blog.subtitle')}>
  <div class="container-px container-mx golden-section">
    <ScrollReveal>
      <p class="section-eyebrow">{t('blog.eyebrow')}</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-3">{t('blog.title')}</h1>
      <p class="text-muted mb-phi-2">{t('blog.subtitle')}</p>
    </ScrollReveal>

    {allTags.length > 0 && (
      <ScrollReveal delay={0.1}>
        <div class="flex flex-wrap gap-2 mb-phi-2">
          <a href={blogBase} class="tag-chip tag-chip-active">
            {t('blog.allTags')}
          </a>
          {allTags.map(({ tag, count }) => (
            <a href={`${tagsBase}/${tag}`} class="tag-chip">
              #{tag} <span class="opacity-50 ml-1">{count}</span>
            </a>
          ))}
        </div>
      </ScrollReveal>
    )}

    {posts.length > 0 ? (
      <StaggerGrid class="grid md:grid-cols-2 lg:grid-cols-3 gap-phi-1">
        {posts.map((post) => (
          <BlogCard post={post} lang={lang} />
        ))}
      </StaggerGrid>
    ) : (
      <div class="text-center py-20 text-muted">
        <p class="text-lg">{t('blog.noPosts')}</p>
      </div>
    )}

    {totalPages > 1 && (
      <div class="flex items-center justify-center gap-2 mt-phi-2">
        {currentPage > 1 && (
          <a href={`${blogBase}?page=${currentPage - 1}`} class="btn btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
            {t('blog.prev')}
          </a>
        )}
        <span class="px-4 py-2 text-sm text-muted font-mono">
          {currentPage} / {totalPages}
        </span>
        {currentPage < totalPages && (
          <a href={`${blogBase}?page=${currentPage + 1}`} class="btn btn-ghost">
            {t('blog.next')}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
          </a>
        )}
      </div>
    )}
  </div>
</BaseLayout>
