---
import BaseLayout from '@layouts/BaseLayout.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Edit this list to manage friend links.
interface Friend {
  name: string;
  url: string;
  desc: string;
  avatar: string;
  color: string; // accent tint for the card glow
}

const friends: Friend[] = [
  {
    name: 'Astro',
    url: 'https://astro.build',
    desc: lang === 'zh' ? '本站使用的 Web 框架，快得离谱。' : 'The web framework this site runs on. Ridiculously fast.',
    avatar: 'https://astro.build/favicon.svg',
    color: '#883aec',
  },
  {
    name: 'Tailwind CSS',
    url: 'https://tailwindcss.com',
    desc: lang === 'zh' ? '实用优先的 CSS 框架，本站样式全靠它。' : 'Utility-first CSS. All the styling here is built with it.',
    avatar: 'https://tailwindcss.com/favicons/favicon.svg',
    color: '#38bdf8',
  },
];
---

<BaseLayout title={t('friends.title')} description={t('friends.subtitle')}>
  <div class="container-px container-mx golden-section" data-section-reveal>
    <div class="flex items-center gap-4 mb-3">
      <span class="section-index">F//</span>
      <p class="section-eyebrow mb-0!" data-scroll-skew data-skew-angle="8deg">{t('friends.eyebrow')}</p>
      <div class="schematic-line flex-1"></div>
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-3">{t('friends.title')}</h1>
    <p class="text-muted mb-phi-2 readout">{t('friends.subtitle')}</p>

    <StaggerGrid class="grid sm:grid-cols-2 gap-phi-1 mb-phi-3">
      {friends.map((f) => (
        <a
          href={f.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card card-hover group flex items-center gap-4 p-phi-1 rounded-[4px] relative"
          style={`--friend-color: ${f.color}`}
          data-tilt
        >
          <div class="relative shrink-0 w-14 h-14">
            {/* First-letter fallback: shown if the remote avatar fails to load */}
            <span
              class="absolute inset-0 rounded-[6px] flex items-center justify-center text-xl font-bold text-white select-none"
              style={`background: ${f.color}`}
              aria-hidden="true"
            >
              {f.name.charAt(0)}
            </span>
            <img
              src={f.avatar}
              alt=""
              loading="lazy"
              data-friend-avatar
              class="relative z-10 w-14 h-14 rounded-[6px] object-cover transition-transform duration-300 group-hover:scale-105 group-hover:rotate-3"
              width="56"
              height="56"
            />
            <span
              class="absolute -inset-1 rounded-[6px] opacity-0 group-hover:opacity-40 blur-lg transition-opacity duration-300 -z-10"
              style={`background: ${f.color}`}
            ></span>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5 mb-1">
              <h3 class="font-bold tracking-tight group-hover:text-[var(--accent)] transition-colors duration-300 truncate font-mono">
                {f.name}
              </h3>
              <svg class="w-3.5 h-3.5 text-muted opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg>
            </div>
            <p class="text-sm text-muted leading-relaxed line-clamp-2">{f.desc}</p>
          </div>
        </a>
      ))}
    </StaggerGrid>

    {/* How to apply */}
    <div class="card p-phi-2 text-center max-w-2xl mx-auto rounded-[4px] relative" data-section-reveal data-reveal-delay="0.15">
      <span class="absolute inset-0 halftone opacity-30 pointer-events-none" aria-hidden="true"></span>
      <div class="relative">
        <p class="text-3xl mb-3 select-none" aria-hidden="true">🐾</p>
        <h2 class="text-xl font-bold tracking-tight mb-2">{t('friends.applyTitle')}</h2>
        <p class="text-sm text-muted leading-relaxed text-balance mb-phi-1">{t('friends.applyDesc')}</p>
        <a
          href="https://github.com/Qwara-chan"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.8 18.3 5.1 18.3 5.1c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z" /></svg>
          {t('friends.applyBtn')}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Remote avatars can 404 or be hotlink-protected. When that happens we hide
  // the broken <img> so the first-letter placeholder underneath shows through
  // instead of the browser's broken-image glyph. The `complete && naturalWidth
  // === 0` check covers the race where the image already failed before this
  // (hoisted) script ran; the error listener covers the normal case.
  function initFriendAvatars() {
    document.querySelectorAll<HTMLImageElement>('img[data-friend-avatar]').forEach((img) => {
      if (img.dataset.fallbackApplied) return;
      const hide = () => {
        img.style.opacity = '0';
        img.dataset.fallbackApplied = '1';
      };
      if (img.complete && img.naturalWidth === 0) {
        hide();
        return;
      }
      img.addEventListener('error', hide, { once: true });
    });
  }

  initFriendAvatars();
  document.addEventListener('astro:after-swap', initFriendAvatars);
</script>
