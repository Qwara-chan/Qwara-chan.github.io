---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';

// This route is intentionally unlinked. It is the payoff for curious cats who
// followed the `data-meow-rev` hint or `window.__qwara.flag()`. No nav, no sitemap noise.

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const flags = [
  'cat-flag: the cat hides in plain sight',
  'reverse-cat: you read the source - you win a cat',
  'meow-ception: the meow is inside you',
];
const flag = flags[Math.floor(Math.random() * flags.length)];

const cat = [
  '   /\\_____/\\',
  '  /  o   o  \\',
  ' ( ==  ^  == )',
  '  )         (',
  ' ( (  )   (  )',
  '(__(__)___(__)__)',
].join('\n');
---

<BaseLayout title={t('secret.title')} description="a cat for curious cats">
  <div class="container-px container-mx py-24 text-center min-h-[60vh] flex flex-col items-center justify-center">
    <pre class="font-mono text-[var(--accent)] leading-none text-[10px] sm:text-xs md:text-sm whitespace-pre mb-3 select-all" aria-hidden="true">{cat}</pre>
    <p class="font-mono text-muted text-xs sm:text-sm mb-8">{t('secret.found')}</p>

    <p class="text-2xl font-extrabold tracking-tight mb-3">{t('secret.unlocked')}</p>
    <p class="text-muted mb-2">{t('secret.noLink')}</p>
    <p class="text-muted text-sm mb-10">{t('secret.haveFlag')}</p>

    <code class="px-4 py-2 rounded-full bg-[var(--bg-elev)] border border-default font-mono text-sm sm:text-base text-[var(--accent)] break-all">
      {flag}
    </code>

    <div class="mt-12 text-xs text-muted font-mono space-y-1">
      <p>{t('secret.howTitle')}</p>
      <p>{t('secret.step1')}</p>
      <p>{t('secret.step2')}</p>
      <p>{t('secret.step3')}</p>
    </div>

    <a href={getLocalizedPath('', lang)} class="btn btn-ghost mt-10">
      {t('secret.backHome')}
    </a>
  </div>
</BaseLayout>

<script is:inline define:vars={{ flags }}>
  (function () {
    // A tiny in-console confirmation for cats who reached the page.
    if (typeof console !== 'undefined' && flags && flags.length) {
      var s = 'color:#e85d2a;font-weight:700;font-size:13px;font-family:ui-monospace,Menlo,Consolas,monospace;';
      console.log('%c🐱 you reached /secret-cat/ - you are a reverse cat.', s);
      window.__meowCount = (window.__meowCount || 0) + 7;
    }
  })();
</script>
