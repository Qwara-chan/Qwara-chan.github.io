---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogCard from '@components/BlogCard.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import type { Post } from '@utils/posts';
import { vtTag } from '@utils/posts';

interface Props {
  tag: string;
  posts: Post[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={t('blog.subtitle')}>
  <div class="container-px container-mx golden-section relative" data-section-reveal>
    <!-- Ghost # — 视差水印 -->
    <span
      class="ghost-numeral right-0 top-10 text-[clamp(5rem,16vw,11rem)]"
      data-parallax
      data-parallax-speed="0.06"
      aria-hidden="true"
    >#</span>
    <a href={getLocalizedPath('blog', lang)} class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-[var(--fg)] transition-colors duration-300 mb-6 font-mono">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7M19 12H5" /></svg>
      {t('blog.back')}
    </a>
    <div class="flex items-center gap-4 mb-3" transition:name="qc-page-head" data-vt>
      <span class="section-index">T//</span>
      <p class="section-eyebrow mb-0!">{t('blog.tags')}</p>
      <div class="schematic-line flex-1"></div>
    </div>
    <h1
      class="font-display text-3xl sm:text-4xl font-black tracking-tight mb-3 font-mono"
      transition:name={`qc-tagword-${vtTag(tag)}`}
      data-vt
    >#{tag}</h1>
    <p class="text-muted mb-10 readout">{posts.length} {t('blog.postsCount')}</p>

    {posts.length > 0 ? (
      <StaggerGrid class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <BlogCard post={post} lang={lang} />
        ))}
      </StaggerGrid>
    ) : (
      <div class="text-center py-20 text-muted">
        <p class="text-lg">{t('blog.noResults')}</p>
      </div>
    )}
  </div>
</BaseLayout>
