---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogCard from '@components/BlogCard.astro';
import StaggerGrid from '@components/animations/StaggerGrid.astro';
import ScrollReveal from '@components/animations/ScrollReveal.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';
import type { Post } from '@utils/posts';

interface Props {
  tag: string;
  posts: Post[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={t('blog.subtitle')}>
  <div class="container-px container-mx golden-section">
    <ScrollReveal>
      <a href={getLocalizedPath('blog', lang)} class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-[var(--fg)] transition-colors duration-300 mb-6">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7M19 12H5" /></svg>
        {t('blog.back')}
      </a>
      <p class="section-eyebrow">{t('blog.tags')}</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">#{tag}</h1>
      <p class="text-muted mb-10">{posts.length} {t('blog.postsCount')}</p>
    </ScrollReveal>

    {posts.length > 0 ? (
      <StaggerGrid class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <BlogCard post={post} lang={lang} />
        ))}
      </StaggerGrid>
    ) : (
      <div class="text-center py-20 text-muted">
        <p class="text-lg">{t('blog.noResults')}</p>
      </div>
    )}
  </div>
</BaseLayout>
