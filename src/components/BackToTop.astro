---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-11 h-11 rounded-full
    bg-[var(--bg-elev)] border border-default text-muted
    hover:text-[var(--accent)] hover:border-[var(--accent)]
    shadow-lg shadow-black/5 dark:shadow-black/20
    transition-all duration-300 ease-[var(--ease-spring)]
    opacity-0 translate-y-4 pointer-events-none"
  data-back-to-top
  aria-label={t('common.backToTop')}
  title={t('common.backToTop')}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="m18 15-6-6-6 6" />
  </svg>
</button>

<script>
  let bttAbort: AbortController | null = null;

  function initBackToTop() {
    bttAbort?.abort();
    bttAbort = new AbortController();
    const { signal } = bttAbort;

    const btn = document.querySelector('[data-back-to-top]');
    if (!btn) return;

    let visible = false;

    function update() {
      const shouldShow = window.scrollY > 400;
      if (shouldShow === visible) return;
      visible = shouldShow;
      btn!.classList.toggle('opacity-0', !shouldShow);
      btn!.classList.toggle('translate-y-4', !shouldShow);
      btn!.classList.toggle('pointer-events-none', !shouldShow);
      btn!.classList.toggle('opacity-100', shouldShow);
      btn!.classList.toggle('translate-y-0', shouldShow);
    }

    window.addEventListener('scroll', update, { passive: true, signal });
    update();

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }, { signal });
  }

  initBackToTop();
  document.addEventListener('astro:after-swap', initBackToTop);
</script>
