---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';
import BootOverlay from '@components/BootOverlay.astro';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fileNo = 'QR-0001';
const sector = '07';
const archived = '1987';
const tapeLabel = 'TAPE 01 · NTSC · TRACK 2';
const camLabel = 'CAM 01 · AUTO-TRACK';
---

<section class="relative min-h-[calc(100vh-4rem)] supports-[min-height:100dvh]:min-h-[calc(100dvh-4rem)] flex flex-col items-center justify-center overflow-hidden" id="hero">
  <!-- 全屏光学层：墙板拼缝 + 扫描线 + 橙色墙板 + 扫描光带 + 菱形框架 -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 wall-grid"></div>
    <div class="scan-full absolute inset-0"></div>
    <span class="absolute left-0 top-[22vh] w-[7px] h-[46vh] bg-[var(--accent)] opacity-85"></span>
    <span class="absolute right-[6vw] top-0 w-[3px] h-[14vh] bg-[var(--accent)] opacity-50"></span>
    <div class="sweep absolute left-0 right-0 h-[24vh]"></div>
  </div>

  <!-- 菱形框架（缓慢自转，方舟式斜切母题）——居中与 45° 初始角完全由 CSS transform 负责，
       不再叠加 Tailwind 的独立 translate/rotate（否则会与 transform 双重合成，偏移一整个宽高） -->
  <div class="diamond-frame absolute left-1/2 top-1/2 pointer-events-none" aria-hidden="true">
    <i class="absolute -top-px left-1/2 -translate-x-1/2 w-[15px] h-[3px] bg-[var(--accent)]"></i>
    <i class="absolute -bottom-px left-1/2 -translate-x-1/2 w-[15px] h-[3px] bg-[var(--accent)]"></i>
    <i class="absolute top-1/2 -left-px -translate-y-1/2 w-[3px] h-[15px] bg-[var(--accent)]"></i>
    <i class="absolute top-1/2 -right-px -translate-y-1/2 w-[3px] h-[15px] bg-[var(--accent)]"></i>
  </div>

  <BootOverlay lang={lang} />

  <!-- Hero 专属 HUD 层（撕裂条/角标/读数等 fixed 装饰）：随 Hero 滚出视口中线后
       整体淡出（data-hero-hud），不盖住下方章节与页脚（2026-08 review 修复）。 -->
  <div data-hero-hud>
  <!-- Glitch 撕裂条（保持 fixed：JS 按视口定位撕裂位置） -->
  <div class="glitchbar fixed left-[-4%] right-[-4%] h-[6px] z-[3] pointer-events-none" id="glitchbar" aria-hidden="true"></div>

  <!-- 视口四角尖角标记（absolute：随 Hero 滚动，Hero 只有 100vh-4rem 高，
       fixed 会钉在视口底部盖住下方内容的标题 → 「字在底栏上部」） -->
  <span class="cb tl absolute top-[62px] left-[18px]" aria-hidden="true"></span>
  <span class="cb tr absolute top-[62px] right-[18px]" aria-hidden="true"></span>
  <span class="cb bl absolute bottom-[104px] left-[18px]" aria-hidden="true"></span>
  <span class="cb br absolute bottom-[104px] right-[18px]" aria-hidden="true"></span>

  <!-- 顶栏 REC + 时间码（在播状态读数） -->
  <div class="rec-readout absolute top-[70px] right-[30px] z-[4] pointer-events-none hero-fade" style="--hero-dur: 0.7s; --hero-delay: 0.2s" aria-hidden="true">
    <span class="rec-dot" id="rec"></span>
    <span class="font-mono phosphor">REC <b id="tc">00:00:00:00</b> · CAM 01</span>
  </div>
  </div>

  <!-- 主舞台 -->
  <div class="container-px container-mx relative z-10 w-full flex flex-col items-center text-center py-24">
    <!-- 信号条（斜切角） -->
    <p class="signal-line hero-fade" style="--hero-dur: 0.7s; --hero-delay: 0.05s" data-hero-signal>
      <span class="sq"></span>
      <span class="font-mono">{t('hero.greeting')}</span>
      <span class="haz" aria-hidden="true"></span>
    </p>

    <!-- 主名（解码） -->
    <div class="name-wrap relative hero-fade" style="--hero-dur: 0.8s; --hero-delay: 0.15s" data-hero-name>
      <h1 class="name" id="hero-name" aria-label={t('hero.name')}>QWARA<span class="dot">.</span></h1>
      <div class="flashbar absolute left-0 right-0 top-1/2 h-[0.16em] z-[3]" id="flash" aria-hidden="true"></div>
    </div>
  </div>

  <!-- 下半部 HUD（档案块/房间号/侧标） -->
  <div data-hero-hud class="hud-lower">
  <!-- 左下档案数据块 -->
  <div class="archive-data absolute left-[30px] bottom-[110px] z-[4] pointer-events-none hero-fade" style="--hero-dur: 0.7s; --hero-delay: 0.3s" aria-hidden="true">
    <span>FILE NO. — <b>{fileNo}</b></span>
    <span>SECTOR — <b>{sector}</b> · CLR — <b>E</b></span>
    <span>ARCHIVED — <b>{archived}</b></span>
  </div>

  <!-- 房间号 -->
  <div class="chamber-tag absolute left-1/2 -translate-x-1/2 bottom-[104px] z-[4] pointer-events-none hero-fade" style="--hero-dur: 0.7s; --hero-delay: 0.4s" aria-hidden="true">
    <span class="font-mono">CHAMBER <b class="text-[var(--accent)]">{sector}</b></span>
  </div>

  <!-- 侧边竖排标注 -->
  <span class="side-label absolute top-1/2 -translate-y-1/2 left-[26px] z-[4] pointer-events-none hero-fade" style="--hero-dur: 0.7s; --hero-delay: 0.25s" aria-hidden="true">{tapeLabel}</span>
  <span class="side-label absolute top-1/2 -translate-y-1/2 right-[26px] z-[4] pointer-events-none hero-fade" style="--hero-dur: 0.7s; --hero-delay: 0.25s" aria-hidden="true">{camLabel}</span>
  </div>

  <!-- 编辑台单独包装：独立快速淡出 —— 快速滚动时内容会进入底栏区域，
       半透明窗口越短，透过底栏看到文字的「透字」越不明显 -->
  <div data-hero-hud class="hud-deck">
  <!-- 黑色编辑台 -->
  <div class="deck absolute left-0 right-0 bottom-0 z-30 hero-fade" style="--hero-dur: 0.7s; --hero-delay: 0.45s" data-hero-deck>
    <div class="vhsbar thin" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="deck-inner">
      <div class="deck-group">
        <button class="tbtn" id="btn-rew" aria-label="rewind" title="REW">◀◀</button>
        <button class="tbtn" id="btn-stop" aria-label="stop" title="STOP">■</button>
        <button class="tbtn primary" id="btn-play" aria-label="play" title="PLAY">▶</button>
        <button class="tbtn" id="btn-ff" aria-label="fast-forward" title="FF">▶▶</button>
      </div>
      <div class="deck-status" id="deck-status">STANDBY — INSERT TAPE</div>
      <div class="deck-right">
        <span class="brand2">QWARA·ARCHIVE</span>
        <span>{tapeLabel.split(' · ')[0]}</span>
        <span class="chamber">CH. {sector}</span>
      </div>
    </div>
  </div>
  </div>
</section>

<style>
  /* 菱形框架旋转（匀速，线性例外，见 CLAUDE.md）——base transform 负责居中 + 45° 初始角，
     keyframes 只改 rotate，避免与 Tailwind 独立 rotate/translate 双重合成 */
  .diamond-frame {
    width: min(86vw, 960px);
    aspect-ratio: 1 / 1;
    border: 1px solid color-mix(in srgb, var(--fg) 16%, transparent);
    transform: translate(-50%, -50%) rotate(45deg);
    animation: dspin 34s linear infinite;
  }
  .diamond-frame::before {
    content: '';
    position: absolute; inset: 15%;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
  }
  @keyframes dspin {
    from { transform: translate(-50%, -50%) rotate(45deg); }
    to { transform: translate(-50%, -50%) rotate(405deg); }
  }

  .scan-full {
    background: repeating-linear-gradient(180deg, color-mix(in srgb, var(--fg) 4%, transparent) 0 1px, transparent 1px 3px);
  }
  .sweep {
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent) 7%, transparent), transparent);
    /* top 是布局属性：光带改为只动 transform（合成器处理），
       不再每帧触发 hero 区域的布局重算（常驻动画，代价最大的一条）。 */
    top: -24vh;
    /* 连续环境扫描（与菱形框架相同的匀速线性例外，见 CLAUDE.md） */
    animation: sweepY 6.5s linear infinite;
  }
  @keyframes sweepY {
    from { transform: translateY(0); }
    to { transform: translateY(148vh); }
  }

  .glitchbar {
    background: linear-gradient(90deg, var(--red), var(--yellow), var(--cyan));
    mix-blend-mode: multiply; opacity: 0;
  }
  .glitchbar.fire { animation: gb 0.42s steps(4) 1; }
  @keyframes gb {
    0% { opacity: 0; } 20% { opacity: 0.7; transform: translateX(-14px); }
    45% { opacity: 0.35; transform: translateX(10px); } 70% { opacity: 0.6; transform: translateX(-6px); }
    100% { opacity: 0; transform: translateX(0); }
  }
  /* 主名的周期性 RGB Glitch 侧移（配合 glitchbar 撕裂条；stepped 硬切，glitch 例外） */
  @keyframes glitchShift {
    0% { transform: translateX(0); }
    50% { transform: translateX(-3px); }
    100% { transform: translateX(0); }
  }

  /* 信号条 */
  .signal-line {
    display: inline-flex; align-items: center; gap: 12px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    padding: 9px 16px;
    margin-bottom: clamp(24px, 5vh, 44px);
    clip-path: polygon(0 0, calc(100% - 11px) 0, 100% 11px, 100% 100%, 11px 100%, 0 calc(100% - 11px));
    color: var(--fg-muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 11px;
  }
  .signal-line .sq { width: 9px; height: 9px; background: var(--accent); flex: none; }
  .signal-line .haz {
    width: 9px; height: 22px; margin-left: 2px; flex: none;
    background: repeating-linear-gradient(-45deg, var(--accent) 0 3px, transparent 3px 6px);
  }

  /* 主名 */
  .name {
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 16vw, 13.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--fg);
    white-space: nowrap;
  }
  .name .dot { color: var(--accent); }
  .flashbar {
    transform: scaleX(0); transform-origin: left center; opacity: 0;
    background: linear-gradient(90deg, var(--accent), var(--yellow));
    mix-blend-mode: multiply;
  }
  .flashbar.fire { animation: flashSweep 0.55s var(--ease-out); }
  @keyframes flashSweep {
    0% { transform: scaleX(0); opacity: 0.5; }
    55% { transform: scaleX(1); opacity: 0.5; }
    100% { transform: scaleX(1); opacity: 0; }
  }

  /* 侧边竖排 */
  .side-label {
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 9px; letter-spacing: 0.34em; text-transform: uppercase;
    color: var(--fg-faint);
  }

  /* 左下数据块 */
  .archive-data {
    font-family: var(--font-mono);
    font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--fg-faint); line-height: 2;
    display: flex; flex-direction: column;
    border-left: 2px solid var(--accent); padding-left: 12px;
  }
  .archive-data b { color: var(--fg); font-weight: 700; }

  /* 房间号斜切块 */
  .chamber-tag {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    padding: 7px 16px;
    clip-path: polygon(9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%, 0 9px);
    color: var(--fg-muted);
    font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase;
  }

  /* 尖角标记 */
  .cb {
    width: 22px; height: 22px;
    border: 0 solid color-mix(in srgb, var(--fg) 55%, transparent);
  }
  .cb.tl { border-top-width: 1.5px; border-left-width: 1.5px; }
  .cb.tr { border-top-width: 1.5px; border-right-width: 1.5px; }
  .cb.bl { border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .cb.br { border-bottom-width: 1.5px; border-right-width: 1.5px; }

  /* REC + 时间码 */
  .rec-readout {
    display: flex; align-items: center; gap: 8px;
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--fg-muted);
  }
  .rec-readout b { color: var(--fg); font-weight: 700; }
  .rec-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #b9ad8f;
  }
  .rec-dot.on { background: var(--red); animation: recBlink 1s steps(1) infinite; }
  @keyframes recBlink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0.15; } }

  /* 编辑台 */
  .deck { background: #14120e; color: #e8e0cc; }
  .deck-inner {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 14px 30px 16px;
    font-family: var(--font-mono);
  }
  .deck-group { display: flex; align-items: center; gap: 12px; }
  .tbtn {
    width: 50px; height: 50px;
    display: flex; align-items: center; justify-content: center;
    background: transparent; border: 1px solid #4a4232; color: #e8e0cc;
    font-size: 16px; font-family: var(--font-mono);
    cursor: pointer; user-select: none;
    transition: all 0.16s var(--ease-out);
  }
  .tbtn:hover { background: var(--accent); border-color: var(--accent); color: #14120e; transform: translateY(-2px); }
  .tbtn:active { transform: translateY(0); }
  .tbtn.primary { background: #e8e0cc; color: #14120e; border-color: #e8e0cc; }
  .tbtn.primary:hover { background: var(--accent); border-color: var(--accent); color: #14120e; }
  .deck-status {
    font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: #b8ae96;
    text-align: center; flex: 1;
  }
  .deck-right {
    display: flex; align-items: center; gap: 18px;
    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: #8f8670;
  }
  .deck-right .brand2 { color: #e8e0cc; letter-spacing: 0.3em; }
  .deck-right .chamber { color: var(--accent); font-weight: 700; }

  /* HUD 层退场/回场：随 Hero 滚出/滚回视口中线切换（JS 通过 IO 切换 .is-past）。
     分层错落 —— 上半（读数/角标）先动，下半（档案块/房间号/侧标）晚 0.12s（hud-lower），
     编辑台单独包装（hud-deck）快速淡出（0.22s，比全层快一倍）再下沉 24px 回位：
     快速滚动时内容会进入底栏区域，编辑台半透明窗口越短，「透过底栏看到文字」越不明显。
     位移保持克制（fixed 层大位移会在内容上方摩擦、读数上浮会顶进 navbar）；位移用
     独立 translate 属性（hero-fade fill 锁死 transform）。闪烁修复：visibility 的
     延迟按状态拆分 —— 回场（is-past 移除）立即 visible，淡入从第一帧渲染；只有退场
     （is-past）才延迟 hidden。若用单一 `visibility 0s 0.45s`，回场淡入全程 hidden，
     结束时突然完整出现 → 闪烁。 */
  [data-hero-hud] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.45s var(--ease-out),
      visibility 0s;
  }
  [data-hero-hud].hud-lower {
    transition-delay: 0.12s, 0s; /* 下半晚 0.12s 展开/收起（回场 visibility 立即） */
  }
  [data-hero-hud].is-past {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-out),
      visibility 0s 0.45s; /* 退场：淡出完再隐藏 */
  }
  [data-hero-hud].hud-lower.is-past {
    transition-delay: 0.12s, 0.57s;
  }
  /* 编辑台单独包装：快速淡出（0.22s），避免快速滚动时内容透过半透明底栏露字 */
  [data-hero-hud].hud-deck {
    transition:
      opacity 0.22s var(--ease-out),
      visibility 0s;
    transition-delay: 0.06s, 0s;
  }
  [data-hero-hud].hud-deck.is-past {
    transition:
      opacity 0.22s var(--ease-out),
      visibility 0s 0.22s;
    transition-delay: 0.06s, 0.28s;
  }
  /* 编辑台：轻微下沉（淡出由 hud-deck 包装负责 —— hero-fade 入场动画的 fill
     会锁死 transform 和 opacity，元素自身的 opacity 规则无效） */
  [data-hero-hud] .deck {
    transition: translate 0.4s var(--ease-out);
    transition-delay: 0.06s;
  }
  [data-hero-hud].is-past .deck {
    translate: 0 24px;
  }

  @media (width < 760px) {
    .side-label, .archive-data { display: none; }
    .deck-status, .deck-right .brand2 { display: none; }
    .deck-inner { padding: 12px 16px 14px; }
    .cb { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    /* `?boot` 强制测试（html.boot-forced）时保留背景动效 */
    html:not(.boot-forced) .diamond-frame,
    html:not(.boot-forced) .sweep,
    html:not(.boot-forced) .scan-full,
    html:not(.boot-forced) .glitchbar { animation: none !important; }
  }
</style>

<script>
  // Fullscreen playback hero: name decode, timecode, periodic glitch,
  // interactive transport deck. Nonlinear motion only (no bounce).
  let heroAbort: AbortController | null = null;

  function initHero() {
    heroAbort?.abort();
    heroAbort = new AbortController();
    const { signal } = heroAbort;

    const nameEl = document.getElementById('hero-name');
    const flashEl = document.getElementById('flash');
    const statusEl = document.getElementById('deck-status');
    const tcEl = document.getElementById('tc');
    const recEl = document.getElementById('rec');
    const glitchbar = document.getElementById('glitchbar');
    if (!nameEl || !statusEl) return;

    const TARGET = 'QWARA.';
    // 不含 HTML 元字符（<>/&）：乱码帧经 innerHTML 写入，`&lt;` 等会被解析器当标签起始吞掉
    const GLYPHS = '█▓▒░/\\|+*$#%?=QWARA0123XYZ@%';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      !document.documentElement.classList.contains('boot-forced'); // `?boot` 强制测试时照常解码

    let started = false;
    let tcActive = false;
    let tcStart = 0;
    // 周期性 Glitch 的独立节拍定时器：不登记进 handles（否则 play()/stop() 的
    // clearAll 会把刚注册的它立刻清掉 → 特效永不触发），abort 时手动销毁。
    let glitchTimer = 0;

    // 统一登记本 init 拥有的所有 setTimeout / setInterval，clearAll() 与 abort
    // 都能停掉进行中的 decode/rewind 帧循环（不登记则 STOP/FF/REW 无法打断解码）。
    let handles: number[] = [];
    function register(h: number) {
      handles.push(h);
      return h;
    }
    function later(fn: () => void, ms: number) {
      register(window.setTimeout(fn, ms));
    }
    function clearAll() {
      handles.forEach((h) => {
        clearTimeout(h);
        clearInterval(h);
      });
      handles = [];
    }

    function setStatus(s: string) {
      statusEl!.textContent = s;
    }

    function renderName(out: string) {
      // TARGET 与 GLYPHS 均不含 HTML 元字符，innerHTML 写入安全；结尾点号包成 accent span
      nameEl!.innerHTML = out.replace(/(\.)$/, '<span class="dot">$1</span>');
    }

    function decode(done?: () => void) {
      const chars = TARGET.split('');
      const total = reduceMotion ? 1 : 24;
      let frame = 0;
      const iv = register(window.setInterval(() => {
        frame++;
        const resolved = Math.round((frame / total) * chars.length);
        let out = '';
        for (let i = 0; i < chars.length; i++) {
          out += i < resolved ? chars[i] : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
        }
        renderName(out);
        if (frame >= total) {
          clearInterval(iv);
          renderName(TARGET);
          // 成字：只留一道扫过的冲击横线（平面扫描，不移动文字）
          if (!reduceMotion && flashEl) {
            flashEl.classList.remove('fire');
            void flashEl.offsetWidth;
            flashEl.classList.add('fire');
          }
          done?.();
        }
      }, reduceMotion ? 0 : 42));
    }

    function startTimecode() {
      tcStart = performance.now(); // 与 MotionBus 的 rAF 时间戳同源
      tcActive = true;
      recEl?.classList.add('on');
    }
    function stopTimecode() {
      tcActive = false;
      recEl?.classList.remove('on');
    }

    function glitchOnce() {
      if (!started || reduceMotion || !glitchbar) return;
      const rect = nameEl!.getBoundingClientRect();
      nameEl!.style.animation = 'none';
      void nameEl!.offsetHeight;
      nameEl!.style.animation = 'glitchShift 0.16s steps(2) 3';
      const top = Math.min(
        window.innerHeight - 60,
        Math.max(0, rect.top + rect.height * (0.4 + Math.random() * 0.4)),
      );
      glitchbar.style.top = `${top}px`;
      glitchbar.classList.remove('fire');
      void glitchbar.offsetWidth;
      glitchbar.classList.add('fire');
      register(window.setTimeout(() => (nameEl!.style.animation = ''), 560));
    }

    function play() {
      clearAll();
      started = true;
      // 首次 play 才启动 Glitch 节拍器（boot 完成或 failsafe 都会经过这里）。
      if (!glitchTimer) glitchTimer = window.setInterval(glitchOnce, 5600);
      setStatus('PLAYING · TAPE 01');
      later(() => {
        startTimecode();
        decode(() => setStatus('PLAYING · AUTO-TRACK DONE'));
      }, reduceMotion ? 100 : 380);
    }
    function stop() {
      clearAll();
      started = false; // 停止后周期性 Glitch 不再开火
      stopTimecode();
      setStatus('STOPPED — FRAME HOLD');
    }
    function rewind() {
      clearAll();
      stopTimecode();
      setStatus('REWINDING…');
      const rev = 11;
      let frame = 0;
      // 登记进 handles：STOP/FF 能打断倒带；完成时 play() 的 clearAll 也会清掉本循环
      register(window.setInterval(() => {
        frame++;
        const keep = Math.max(0, TARGET.length - Math.round((frame / rev) * TARGET.length));
        let out = '';
        for (let i = 0; i < TARGET.length; i++) {
          out += i < keep ? TARGET[i] : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
        }
        renderName(out);
        if (frame >= rev) {
          play();
        }
      }, 60));
    }
    function ff() {
      clearAll();
      started = true;
      renderName(TARGET);
      setStatus('PLAYING · FAST');
      startTimecode();
    }

    const playBtn = document.getElementById('btn-play');
    const stopBtn = document.getElementById('btn-stop');
    const rewBtn = document.getElementById('btn-rew');
    const ffBtn = document.getElementById('btn-ff');
    playBtn?.addEventListener('click', play, { signal });
    stopBtn?.addEventListener('click', stop, { signal });
    rewBtn?.addEventListener('click', rewind, { signal });
    ffBtn?.addEventListener('click', ff, { signal });

    // HUD 层随 Hero 滚出视口中线后淡出：它们是 fixed 钉在视口上的装饰，不隐藏会
    // 盖住下方章节与页脚。观察区取「视口下半屏」（rootMargin top -50% → 观察区
    // [50vh, 100vh]）：hero 底边越过视口中线即完全离开观察区 → 触发。注意正值
    // rootMargin 是向外扩大（top +50% 会把观察区推到视口上方，无效）；用 bottom
    // 收窄也无效 —— hero 是从顶部离开观察区的，要等它完全滚出视口才触发，deck
    // 会挡内容过久。rootMargin 只接受 px/% 单位，不能用 vh。
    const hudEls = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-hud]'));
    const heroSec = document.getElementById('hero');
    if (hudEls.length && heroSec && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const past = !e.isIntersecting;
            hudEls.forEach((el) => el.classList.toggle('is-past', past));
          }
        },
        { rootMargin: '-50% 0px 0px 0px' },
      );
      io.observe(heroSec);
      signal.addEventListener('abort', () => io.disconnect());
    }

    // 走秒（Hero 顶栏时间码）——逐帧工作注册到 MotionBus 单一 rAF 循环，不再独占一个 33ms interval。
    // 字符串缓存：帧率（30fps）高于可见变化，只有串真的变了才写 textContent，
    // 否则每帧都在逼 30fps 次文本重排。
    let lastTc = '';
    const addTcDriver = () =>
      (window as unknown as { __motionBus?: { add(id: string, f: (s: { time: number }) => void): void; remove(id: string): void } }).__motionBus?.add(
        'hero-tc',
        (state) => {
          if (!tcActive || !tcEl) return;
          const t = state.time - tcStart;
          const p = (n: number) => (n < 10 ? '0' : '') + n;
          const h = Math.floor(t / 3600000);
          const m = Math.floor(t / 60000) % 60;
          const s = Math.floor(t / 1000) % 60;
          const f = Math.floor(((t % 1000) / 1000) * 30);
          const str = `${p(h)}:${p(m)}:${p(s)}:${p(f)}`;
          if (str !== lastTc) {
            lastTc = str;
            tcEl.textContent = str;
          }
        },
      );
    if ((window as unknown as { __motionBus?: unknown }).__motionBus) addTcDriver();
    else requestAnimationFrame(addTcDriver); // 1 帧重试，应对 chunk 顺序

    // 等 boot 就绪（hero-booting 移除）或直接开始
    function startWhenReady() {
      if (document.documentElement.classList.contains('hero-booting')) {
        // 双保险去重：boot-done 与 3200ms failsafe 只会真正 play 一次——
        // 先到的一方移除对方监听（booted 守卫），后到的一方直接 no-op。
        let booted = false;
        const begin = () => {
          if (booted) return;
          booted = true;
          window.removeEventListener('qw:boot-done', begin);
          play();
        };
        window.addEventListener('qw:boot-done', begin, { once: true, signal });
        later(begin, 5200); // failsafe（开机序列加长至 ~3.4s；boot-done 先到仍由它触发）
      } else {
        play();
      }
    }

    // 卸载/换页：清掉所有 handle + Glitch 节拍器 + 移除 bus 驱动，杜绝僵尸计时器打到已脱离的 DOM
    signal.addEventListener('abort', () => {
      clearAll();
      if (glitchTimer) window.clearInterval(glitchTimer);
      (window as unknown as { __motionBus?: { remove(id: string): void } }).__motionBus?.remove('hero-tc');
    });

    startWhenReady();
  }

  initHero();
  document.addEventListener('astro:after-swap', initHero);
</script>
