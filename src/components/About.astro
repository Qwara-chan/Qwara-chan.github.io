---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import type { Lang } from '@i18n/ui';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="golden-section relative">
  <div class="container-px container-mx">
    <div class="flex items-center gap-4 mb-phi-1">
      <span class="section-index">01 //</span>
      <p class="section-eyebrow mb-0!">{t('about.eyebrow')}</p>
      <div class="schematic-line flex-1"></div>
    </div>

    <div class="max-w-3xl">
      <h2 class="section-title mb-3 plate-heading">{t('about.title')}</h2>

      <p class="text-base sm:text-lg leading-relaxed text-muted mb-4">{t('about.p1')}</p>

      <p class="text-base sm:text-lg leading-relaxed text-muted mb-phi-2">{t('about.p2')}</p>
    </div>
  </div>
</section>
