<script is:inline>
  // Reverse-cat console journey — the de-emphasized easter-egg layer.
  //
  // All on-screen cat effects (emoji rain, konami, typing triggers, poke, tab
  // away) were removed in the 2026-08 "purity" pass. What remains is a
  // devtools-only treasure hunt: a console banner, an undocumented `window.__qwara`
  // REPL, a DOM attribute hint, and the hidden /secret-cat/ route. Nothing here
  // ever renders to the page.
  //
  // Deferred to idle time so this small script never blocks first paint.
  (function () {
    function boot() {

      // ---------- console kitty banner (line-by-line so Firefox doesn't collapse it) ----------
      if (typeof console !== 'undefined') {
        var lineStyle = 'color: #e85d2a; font-weight: 700; font-size: 13px; line-height: 1.2; font-family: ui-monospace, Menlo, Consolas, monospace;';
        var bannerLines = [
          '   /\\_____/\\',
          '  /  o   o  \\',
          ' ( ==  ^  == )',
          '  )         (',
          ' ( (  )   (  )',
          '(__(__)___(__)__)',
        ];
        bannerLines.forEach(function (ln) { console.log('%c' + ln, lineStyle); });
        console.log('%c hey curious cat ~ welcome to the archive ', 'background:#e85d2a;color:#f6f1e5;padding:2px 8px;border-radius:4px;');
        console.log('%c psst… try __qwara.help()', 'color:#8a8374;font-size:11px;');
      }

      // ---------- reverse-engineering easter eggs (for curious cats who read source/devtools) ----------
      // A tiny undocumented surface: window.__qwara, a global data-meow-rev attribute,
      // and a hidden /secret-cat/ route. Nothing is required to enjoy the site.
      (function setupRevEgg () {
        var hintStyle = 'color:#f0833d;font-weight:600;font-size:12px;font-family:ui-monospace,Menlo,Consolas,monospace;';
        var dim = 'color:#8a8374;font-size:11px;font-family:ui-monospace,Menlo,Consolas,monospace;';
        // A flag that lives in the DOM (base64) — readable by anyone who looks.
        var FLAG_B64 = 'Y2F0LWZsYWc6IHRoZSBjYXQgaGlkZXMgaW4gcGxhaW4gc2lnaHQ='; // "cat-flag: the cat hides in plain sight"
        var unCat = function (s) {
          try { return typeof atob === 'function' ? atob(s) : s; } catch (e) { return s; }
        };

        // An undocumented console object. Curious cats who type `__qwara` get a mini REPL.
        var unlocked = false;
        var cmds = {
          help: function () {
            return [
              '__qwara.cmds — a tiny console playground for reverse-cats',
              '  help()                  list commands',
              '  flag()                  decode the cat flag',
              '  whoami()                who is the cat, really?',
              '  meowness()              how much meow has happened',
              '  ping()                  pong~',
            ].join('\n');
          },
          flag: function () { return unCat(FLAG_B64); },
          whoami: function () { return 'just a cat who read the source, like you 🐾'; },
          meowness: function () { return 'meowness level: ' + (window.__meowCount || 0); },
          ping: function () { return 'pong~ meow'; },
        };

        // configurable: false 的访问器不能再被 defineProperty 重定义 —— Astro 的路由
        // 每次换页都会重新执行本内联脚本，第二次执行会抛 TypeError 并跳过后续 boot()。
        // 用 hasOwnProperty 守卫：首次定义后，后续执行直接复用既有 getter。
        if (!Object.prototype.hasOwnProperty.call(window, '__qwara')) {
          Object.defineProperty(window, '__qwara', {
            configurable: false,
            enumerable: false,
            get: function () {
              if (!unlocked) {
                unlocked = true;
                console.log('%c🐾 psst… you found window.__qwara', hintStyle);
                console.log('%ctry: __qwara.help()', dim);
              }
              return cmds;
            },
          });
        }

        // A global attribute — somewhere on the page an element carries data-meow-rev.
        var revEl = document.querySelector('[data-meow-rev]');
        if (revEl) {
          var revHint = revEl.getAttribute('data-meow-rev') || '';
          console.log('%c[data-meow-rev] found on <' + (revEl.tagName.toLowerCase()) + '>', dim);
          console.log('%c' + revHint, dim);
        }
        // The ASCII flag is available via the hidden route: src/pages/secret-cat.astro
      })();
    } // end boot()

    if (window.requestIdleCallback) {
      window.requestIdleCallback(boot, { timeout: 3000 });
    } else if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      setTimeout(boot, 0);
    }
  })();
</script>
