---
import TagPage from '@components/pages/TagPage.astro';
import { getAllTags, getPostsByTag } from '@utils/posts';

export async function getStaticPaths() {
  const tags = await getAllTags('en');
  const paths = [];
  for (const { tag } of tags) {
    const posts = await getPostsByTag(tag, 'en');
    paths.push({ params: { tag }, props: { tag, posts } });
  }
  return paths;
}

const { tag, posts } = Astro.props;
---

<TagPage tag={tag} posts={posts} />
