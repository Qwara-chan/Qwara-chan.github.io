---
import BaseLayout from '@layouts/BaseLayout.astro';
import ScrollReveal from '@components/animations/ScrollReveal.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title="404">
  <div class="container-px container-mx py-32 text-center">
    <ScrollReveal y={20}>
      <p class="text-8xl sm:text-9xl font-extrabold font-mono text-muted opacity-20 mb-4">404</p>
      <h1 class="text-2xl font-bold tracking-tight mb-3">{t('404.title')}</h1>
      <p class="text-muted mb-8">{t('404.desc')}</p>
      <a href={getLocalizedPath('', lang)} class="btn btn-primary">
        {t('404.home')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
      </a>
    </ScrollReveal>
  </div>
</BaseLayout>
