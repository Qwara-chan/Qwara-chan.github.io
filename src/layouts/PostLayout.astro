---
import BaseLayout from './BaseLayout.astro';
import Mermaid from '@components/Mermaid.astro';
import '@styles/katex.css';
import { getLangFromUrl, useTranslations, formatDate, getReadingTime, getWordCount, getLocalizedPath } from '@i18n/utils';
import { render } from 'astro:content';
import { getPosts, noteHash, vtTag, type Post } from '@utils/posts';
import type { Lang } from '@i18n/ui';

interface Props {
  post: Post;
  prevPost?: Post | null;
  nextPost?: Post | null;
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { post, prevPost = null, nextPost = null } = Astro.props;

const { Content, headings } = await render(post);
const bodyText = post.body ?? '';
const readingTime = getReadingTime(bodyText, lang);
const wordCount = getWordCount(bodyText, lang);

const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const blogHref = getLocalizedPath('blog', lang);

const tags = post.data.tags;

// OG image lives in the post's own locale route: under en→zh fallback the page
// is served at /en/blog/<slug> but only /og/<slug>.png is generated for a zh post.
const ogImage = getLocalizedPath(`og/${post.id}`, post.data.lang) + '.png';

const prevHref = prevPost ? getLocalizedPath(`blog/${prevPost.id}`, lang) : null;
const nextHref = nextPost ? getLocalizedPath(`blog/${nextPost.id}`, lang) : null;

// Related posts: ranked by shared tags, then by recency.
const allPosts = await getPosts(lang);
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({ post: p, score: p.data.tags.filter((tag) => tags.includes(tag)).length }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime())
  .slice(0, 3)
  .map((x) => x.post);
---

<BaseLayout title={post.data.title} description={post.data.description} image={ogImage}>
  <article class="container-px container-mx py-phi-2 sm:py-phi-3 relative" data-section-reveal>
    <a href={blogHref} class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-[var(--fg)] transition-colors duration-300 mb-8 font-mono">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7M19 12H5" /></svg>
      {t('blog.back')}
    </a>

    {/* 封面区：卡片封面的变形落点（qc-cover-*）。无 cover 时渲染与
        BlogCard 逐字同构的 halftone 首字占位帧，保证变形连续。 */}
    <div
      class="corner-cut relative mb-phi-2 aspect-[21/9] max-h-[400px] w-full overflow-hidden bg-[var(--bg-elev)]"
      transition:name={`qc-cover-${post.id}`}
      data-vt
    >
      {post.data.cover ? (
        <img src={post.data.cover} alt={post.data.title} class="h-full w-full object-cover" />
      ) : (
        <div class="w-full h-full flex items-center justify-center relative overflow-hidden halftone"
          style="background-color: var(--bg-elev);">
          <div class="absolute inset-0 opacity-[0.08]" style="background-image: linear-gradient(var(--fg) 1px, transparent 1px), linear-gradient(90deg, var(--fg) 1px, transparent 1px); background-size: 32px 32px;"></div>
          <span class="relative font-mono text-7xl sm:text-8xl font-black text-[var(--accent)] opacity-40 select-none">{post.data.title.charAt(0)}</span>
        </div>
      )}
      <div class="vhsbar thin absolute inset-x-0 top-0 z-10 pointer-events-none" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <span
        class="absolute top-4 left-3 px-1.5 py-0.5 text-[9px] font-mono font-bold uppercase tracking-wider text-[var(--on-accent)] z-10 corner-cut"
        style="background: var(--accent); --corner-cut: 5px"
        transition:name={`qc-note-${post.id}`}
      >
        NOTE #{noteHash(post.data.title)}
      </span>
    </div>

    <div class="grid lg:grid-cols-[1.618fr_1fr] gap-phi-3">
      <div class="min-w-0">
        <div class="flex items-center gap-4 mb-4" transition:name="qc-page-head" data-vt>
          <span class="section-index">P//</span>
          <div class="schematic-line flex-1"></div>
        </div>

        <div class="flex flex-wrap items-center gap-3 text-sm text-muted font-mono mb-4">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
          {post.data.updatedDate && post.data.updatedDate.getTime() !== post.data.pubDate.getTime() && (
            <>
              <span class="w-1 h-1 rounded-full bg-current opacity-30"></span>
              <span class="text-[var(--accent)]">
                {t('blog.updatedOn')} {formatDate(post.data.updatedDate, lang)}
              </span>
            </>
          )}
          <span class="w-1 h-1 rounded-full bg-current opacity-30"></span>
          <span>{readingTime} {t('blog.minRead')}</span>
          <span class="w-1 h-1 rounded-full bg-current opacity-30"></span>
          <span>{wordCount.toLocaleString()} {t('common.words')}</span>
        </div>
        <h1
          class="chroma font-display text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight mb-phi-1"
          transition:name={`qc-title-${post.id}`}
          data-vt
        >
          {post.data.title}
        </h1>
        <p class="text-lg text-muted leading-relaxed mb-phi-1">{post.data.description}</p>

        <div class="flex flex-wrap items-center gap-2 mb-phi-2">
          {tags.length > 0 && tags.map((tag) => (
            <a
              href={`${getLocalizedPath('tags', lang)}/${encodeURIComponent(tag)}`}
              class="tag-chip font-mono"
              transition:name={`qc-tag-${post.id}-${vtTag(tag)}`}
            >#{tag}</a>
          ))}

            <!-- Share / copy link -->
            <button
              type="button"
              class="tag-chip cursor-pointer inline-flex items-center gap-1.5 ml-auto"
              data-share-btn
              aria-label={t('common.share')}
              title={t('common.share')}
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>
              <span data-share-label>{t('common.share')}</span>
            </button>
          </div>

          <div class="h-px bg-[var(--border)] mb-phi-2"></div>

        {tocItems.length > 0 && (
          <details class="lg:hidden card p-4 mb-phi-1" data-mobile-toc>
            <summary class="text-xs font-mono uppercase tracking-wider text-muted cursor-pointer select-none flex items-center gap-2">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              {t('blog.toc')}
            </summary>
            <nav class="mt-4 space-y-2 text-sm">
              {tocItems.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class:list={['block text-muted hover:text-[var(--fg)] transition-colors duration-200', heading.depth === 3 && 'pl-3']}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </details>
        )}

        <div class="reading-progress-wrapper" data-reading-progress>
          <div class="prose prose-lg max-w-none dark:prose-invert
            prose-headings:scroll-mt-20 prose-headings:tracking-tight
            prose-code:before:hidden prose-code:after:hidden
            prose-code:rounded prose-code:bg-[var(--paper-2)] dark:prose-code:bg-[var(--paper-3)]
            prose-code:px-1.5 prose-code:py-0.5 prose-code:text-sm prose-code:font-mono
            prose-pre:rounded-phi-md prose-pre:border prose-pre:border-[var(--border)]
            prose-img:rounded-phi-md prose-img:cursor-zoom-in
            prose-blockquote:not-italic prose-blockquote:border-[var(--fg)]"
          >
            <Content />
          </div>
        </div>

        <!-- Prev / Next post navigation -->
        {(prevPost || nextPost) && (
          <nav class="mt-phi-3 pt-phi-2 border-t border-default grid gap-4" style={`grid-template-columns: ${prevPost && nextPost ? '1fr 1fr' : '1fr'}`}>
            {prevPost && (
              <a
                href={prevHref!}
                class="card card-hover block p-phi-1 group"
              >
                <span class="text-xs font-mono uppercase tracking-wider text-muted mb-2 block">{t('blog.prevPost')}</span>
                <span class="font-semibold tracking-tight group-hover:text-[var(--accent)] transition-colors duration-300 line-clamp-2">
                  &larr; {prevPost.data.title}
                </span>
              </a>
            )}
            {nextPost && (
              <a
                href={nextHref!}
                class:list={['card card-hover block p-phi-1 group text-right', !prevPost && 'sm:col-start-2']}
              >
                <span class="text-xs font-mono uppercase tracking-wider text-muted mb-2 block">{t('blog.nextPost')}</span>
                <span class="font-semibold tracking-tight group-hover:text-[var(--accent)] transition-colors duration-300 line-clamp-2">
                  {nextPost.data.title} &rarr;
                </span>
              </a>
            )}
          </nav>
        )}

        {related.length > 0 && (
          <section class="mt-phi-2">
            <h2 class="text-xs font-mono uppercase tracking-wider text-muted mb-phi-1">{t('blog.related')}</h2>
            <div class="grid sm:grid-cols-3 gap-4">
              {related.map((rp) => (
                <a href={getLocalizedPath(`blog/${rp.id}`, lang)} class="card card-hover p-4 group">
                  <span class="text-xs font-mono text-muted block mb-2">{formatDate(rp.data.pubDate, lang)}</span>
                  <span class="font-semibold tracking-tight text-sm group-hover:text-[var(--accent)] transition-colors duration-300 line-clamp-2">{rp.data.title}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      {tocItems.length > 0 && (
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <p class="text-xs font-mono uppercase tracking-wider text-muted mb-4">{t('blog.toc')}</p>
            <nav class="space-y-2 text-sm">
              {tocItems.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class:list={[
                    'block text-muted hover:text-[var(--fg)] transition-colors duration-200',
                    heading.depth === 3 && 'pl-3',
                  ]}
                  data-toc-link={heading.slug}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </article>

  <Mermaid />

  <!-- Reading progress bar -->
  <div
    class="fixed top-0 left-0 right-0 h-0.5 z-[60] bg-[var(--accent)] origin-left scale-x-0"
    data-reading-bar
  ></div>

  <!-- Image lightbox overlay -->
  <div
    class="fixed inset-0 z-[70] bg-black/80 backdrop-blur-sm flex items-center justify-center p-4
      opacity-0 pointer-events-none transition-opacity duration-300 cursor-zoom-out"
    data-lightbox
  >
    <img
      src=""
      alt=""
      class="max-w-full max-h-[90vh] rounded-phi-md shadow-2xl transition-transform duration-300 scale-95"
      data-lightbox-img
    />
  </div>

  <script>
    let postAbort: AbortController | null = null;
    let tocObserver: IntersectionObserver | null = null;

    function initReadingProgress() {
      postAbort?.abort();
      postAbort = new AbortController();
      const { signal } = postAbort;

      tocObserver?.disconnect();
      tocObserver = null;

      // --- Reading progress bar ---
      const bar = document.querySelector('[data-reading-bar]');
      if (bar) {
        function update() {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? scrollTop / docHeight : 0;
          (bar as HTMLElement).style.transform = `scaleX(${progress})`;
        }
        window.addEventListener('scroll', update, { passive: true, signal });
        update();

        // --- Reading position memory (restored on back/forward via bfcache) ---
        const posKey = 'qwara:scroll:' + window.location.pathname;
        let saveTimer: number | undefined;
        window.addEventListener('scroll', () => {
          clearTimeout(saveTimer);
          saveTimer = window.setTimeout(() => {
            try { sessionStorage.setItem(posKey, String(window.scrollY)); } catch {}
          }, 200);
        }, { passive: true, signal });
        window.addEventListener('pageshow', (e) => {
          if (e.persisted) {
            const saved = parseInt(sessionStorage.getItem(posKey) || '0', 10);
            if (saved > 300) {
              requestAnimationFrame(() => window.scrollTo(0, saved));
            }
          }
        }, { signal });

        // --- Mobile TOC: close on link click ---
        const mobileToc = document.querySelector('[data-mobile-toc]');
        if (mobileToc) {
          mobileToc.querySelectorAll('a').forEach((a) => {
            a.addEventListener('click', () => {
              (mobileToc as HTMLDetailsElement).open = false;
            }, { signal });
          });
        }
      }

      // --- TOC active heading highlight ---
      const tocLinks = document.querySelectorAll('[data-toc-link]');
      if (tocLinks.length > 0) {
        const headings = Array.from(tocLinks).map((link) => {
          const slug = link.getAttribute('data-toc-link');
          return { link, el: document.getElementById(slug!) };
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                tocLinks.forEach((l) => l.classList.remove('text-[var(--fg)]', 'font-semibold'));
                const activeLink = document.querySelector(`[data-toc-link="${entry.target.id}"]`);
                activeLink?.classList.add('text-[var(--fg)]', 'font-semibold');
              }
            });
          },
          { rootMargin: '-80px 0px -70% 0px' }
        );
        tocObserver = observer;

        headings.forEach(({ el }) => {
          if (el) observer.observe(el);
        });
      }

      // --- Code block copy buttons ---
      document.querySelectorAll('pre code').forEach((block) => {
        const pre = block.parentElement;
        if (!pre || pre.querySelector('.copy-btn')) return;

        // Language label (top-left) - Astro 7 Shiki uses pre[data-language]
        const langMatch = pre.getAttribute('data-language') || (block.className.match(/language-(\w+)/) || [])[1];
        if (langMatch && langMatch !== 'plaintext') {
          const label = document.createElement('span');
          label.className = 'code-lang-label absolute top-3 left-3 text-xs font-mono select-none pointer-events-none';
          label.style.opacity = '0.4';
          label.textContent = langMatch;
          pre.appendChild(label);
        }

        const btn = document.createElement('button');
        btn.className = 'copy-btn absolute top-3 right-3 px-2 py-1 rounded-md text-xs font-mono bg-[var(--bg-elev)] border border-default text-muted hover:text-[var(--fg)] transition-colors opacity-0 group-hover:opacity-100';
        btn.textContent = 'Copy';

        pre.classList.add('relative', 'group');
        pre.appendChild(btn);

        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(block.textContent || '');
          btn.textContent = 'Copied!';
          setTimeout(() => (btn.textContent = 'Copy'), 2000);
        });
      });

      // --- Share / copy link button ---
      const shareBtn = document.querySelector('[data-share-btn]');
      const shareLabel = document.querySelector('[data-share-label]');
      if (shareBtn && shareLabel) {
        const originalText = shareLabel.textContent;
        shareBtn.addEventListener('click', async () => {
          const url = window.location.href;
          // Try native share first (mobile), fall back to clipboard
          if (navigator.share) {
            try {
              await navigator.share({ title: document.title, url });
              return;
            } catch { /* user cancelled — fall through to copy */ }
          }
          try {
            await navigator.clipboard.writeText(url);
            shareLabel.textContent = '✓ ' + (originalText === '分享' ? '已复制' : 'Copied');
            setTimeout(() => { shareLabel.textContent = originalText; }, 2000);
          } catch {
            shareLabel.textContent = url;
          }
        }, { signal });
      }

      // --- External link indicator ---
      const proseRoot = document.querySelector('.prose');
      if (proseRoot) {
        const siteHost = window.location.hostname;
        proseRoot.querySelectorAll('a[href^="http"]').forEach((a) => {
          const link = a as HTMLAnchorElement;
          try {
            const u = new URL(link.href);
            if (u.hostname !== siteHost && !link.querySelector('[data-ext-icon]')) {
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
              icon.setAttribute('data-ext-icon', '');
              icon.setAttribute('width', '12');
              icon.setAttribute('height', '12');
              icon.setAttribute('viewBox', '0 0 24 24');
              icon.setAttribute('fill', 'none');
              icon.setAttribute('stroke', 'currentColor');
              icon.setAttribute('stroke-width', '2.5');
              icon.setAttribute('stroke-linecap', 'round');
              icon.setAttribute('stroke-linejoin', 'round');
              icon.style.cssText = 'display:inline-block;vertical-align:baseline;margin-inline-start:0.2em;opacity:0.6;';
              const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
              p.setAttribute('d', 'M7 17 17 7M7 7h10v10');
              icon.appendChild(p);
              link.appendChild(icon);
            }
          } catch { /* invalid URL — skip */ }
        });
      }

      // --- Image lightbox ---
      const lightbox = document.querySelector('[data-lightbox]');
      const lightboxImg = document.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
      if (lightbox && lightboxImg) {
        const proseImgs = document.querySelectorAll('.prose img');
        proseImgs.forEach((img) => {
          img.addEventListener('click', () => {
            lightboxImg.src = (img as HTMLImageElement).src;
            lightboxImg.alt = (img as HTMLImageElement).alt;
            lightbox.classList.remove('opacity-0', 'pointer-events-none');
            lightbox.classList.add('opacity-100');
            lightboxImg.classList.remove('scale-95');
            lightboxImg.classList.add('scale-100');
            document.body.classList.add('overflow-hidden');
          }, { signal });
        });

        function closeLightbox() {
          lightbox!.classList.add('opacity-0', 'pointer-events-none');
          lightbox!.classList.remove('opacity-100');
          lightboxImg!.classList.add('scale-95');
          lightboxImg!.classList.remove('scale-100');
          document.body.classList.remove('overflow-hidden');
        }

        lightbox.addEventListener('click', closeLightbox, { signal });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeLightbox();
        }, { signal });
      }
    }

    initReadingProgress();
    document.addEventListener('astro:after-swap', initReadingProgress);
  </script>
</BaseLayout>
