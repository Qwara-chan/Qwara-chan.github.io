---
import { ClientRouter } from 'astro:transitions';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import MeowEasterEgg from '@components/MeowEasterEgg.astro';
import { getLangFromUrl, getSwitchHref } from '@i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const lang = getLangFromUrl(Astro.url);

const {
  title,
  description = lang === 'zh'
    ? 'Qwara 的个人主页 — 全栈开发者、开源爱好者。技术博客、项目作品集与个人介绍。'
    : "Qwara's personal site — full-stack developer, open source enthusiast. Blog, projects and about.",
  image = '/og-image.svg',
} = Astro.props;

const siteName = 'Qwara';
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} — ${lang === 'zh' ? '全栈开发者' : 'Full-Stack Developer'}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();

const zhHref = getSwitchHref(Astro.url, 'zh');
const enHref = getSwitchHref(Astro.url, 'en');
---

<!--
   /\_____/\
  /  o   o  \    meow~
 ( ==  ^  == )
  )         (
 ( (  )   (  )
(__(__)___(__)__)
-->

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="zh-CN" href={new URL(zhHref, Astro.site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={lang === 'zh' ? '/rss.xml' : '/en/rss.xml'}
    />

    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/fonts/HarmonyOS_Sans_SC_Regular_Latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (theme === 'dark' || (!theme && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <script>
      // Re-apply theme after Astro View Transitions swap. We do this once
      // on `after-swap` only — running on `before-swap` mutates the *outgoing*
      // document and is discarded. The inline boot script already painted the
      // first page correctly, so the only thing to keep in sync is the
      // newly-swapped document.
      function reapplyTheme() {
        try {
          const theme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = theme === 'dark' || (!theme && prefersDark);
          document.documentElement.classList.toggle('dark', isDark);
        } catch (e) {}
      }
      document.addEventListener('astro:after-swap', reapplyTheme);

      // Kill all GSAP ScrollTriggers before swapping the DOM so ScrollTrigger
      // doesn't keep refreshing against detached triggers. The dynamic import
      // shares the cached module already loaded by hero/scroll-reveal/stagger.
      document.addEventListener('astro:before-swap', async () => {
        try {
          const { ScrollTrigger } = await import('gsap/ScrollTrigger');
          ScrollTrigger.getAll().forEach((t) => t.kill());
        } catch (e) {
          /* GSAP not on this page — nothing to clean up */
        }
      });
    </script>
  </head>
  <body>
    <Navbar lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <MeowEasterEgg />
  </body>
</html>
